{
  "lib/src/phy/ch_estimation/dmrs_sch.c": {
    "sha256": "80018675e632f7ee6f04bf2061fb6cf269ecc06d61aac86921d523364c00c8e1",
    "lines": [
      {
        "line": 815,
        "text": "  // Estimate average synchronization error"
      },
      {
        "line": 816,
        "text": "  float dmrs_stride = (dmrs_cfg->type == srsran_dmrs_sch_type_1) ? 2 : 3;"
      },
      {
        "line": 817,
        "text": "  float sync_err    = 0.0f;"
      },
      {
        "line": 818,
        "text": "  for (uint32_t i = 0; i < nof_symbols; i++) {"
      },
      {
        "line": 819,
        "text": "    sync_err += srsran_vec_estimate_frequency(&q->pilot_estimates[nof_pilots_x_symbol * i], nof_pilots_x_symbol);"
      },
      {
        "line": 820,
        "text": "  }"
      },
      {
        "line": 821,
        "text": "  sync_err /= (float)nof_symbols;"
      },
      {
        "line": 822,
        "text": "  float delay_us = sync_err / (dmrs_stride * SRSRAN_SUBC_SPACING_NR(q->carrier.scs));"
      },
      {
        "line": 823,
        "text": ""
      },
      {
        "line": 824,
        "text": "#if DMRS_SCH_SYNC_PRECOMPENSATE"
      },
      {
        "line": 825,
        "text": "  // Pre-compensate synchronization error"
      },
      {
        "line": 826,
        "text": "  if (isnormal(sync_err)) {"
      },
      {
        "line": 827,
        "text": "    for (uint32_t i = 0; i < nof_symbols; i++) {"
      },
      {
        "line": 828,
        "text": "      srsran_vec_apply_cfo(&q->pilot_estimates[nof_pilots_x_symbol * i],"
      },
      {
        "line": 829,
        "text": "                           sync_err,"
      },
      {
        "line": 830,
        "text": "                           &q->pilot_estimates[nof_pilots_x_symbol * i],"
      },
      {
        "line": 831,
        "text": "                           nof_pilots_x_symbol);"
      },
      {
        "line": 832,
        "text": "    }"
      },
      {
        "line": 833,
        "text": "  }"
      },
      {
        "line": 834,
        "text": "#endif // DMRS_SCH_SYNC_ERROR_PRECOMPENSATE"
      },
      {
        "line": 835,
        "text": ""
      },
      {
        "line": 836,
        "text": "  // Perform Power measurements"
      },
      {
        "line": 837,
        "text": "  float rsrp                              = 0.0f;"
      },
      {
        "line": 838,
        "text": "  float epre                              = 0.0f;"
      },
      {
        "line": 839,
        "text": "  cf_t  corr[SRSRAN_DMRS_SCH_MAX_SYMBOLS] = {};"
      },
      {
        "line": 840,
        "text": "  for (uint32_t i = 0; i < nof_symbols; i++) {"
      },
      {
        "line": 841,
        "text": "    corr[i] ="
      },
      {
        "line": 842,
        "text": "        srsran_vec_acc_cc(&q->pilot_estimates[nof_pilots_x_symbol * i], nof_pilots_x_symbol) / nof_pilots_x_symbol;"
      },
      {
        "line": 843,
        "text": "    rsrp += __real__ corr[i] * __real__ corr[i] + __imag__ corr[i] * __imag__ corr[i];"
      },
      {
        "line": 844,
        "text": "    epre += srsran_vec_avg_power_cf(&q->pilot_estimates[nof_pilots_x_symbol * i], nof_pilots_x_symbol);"
      },
      {
        "line": 845,
        "text": "  }"
      },
      {
        "line": 846,
        "text": "  rsrp /= nof_symbols;"
      },
      {
        "line": 847,
        "text": "  epre /= nof_symbols;"
      },
      {
        "line": 848,
        "text": "  rsrp = SRSRAN_MIN(rsrp, epre - epre * 1e-7);"
      },
      {
        "line": 849,
        "text": ""
      },
      {
        "line": 850,
        "text": "  // Measure CFO if more than one symbol is used"
      },
      {
        "line": 851,
        "text": "  float cfo_avg_hz = 0.0;"
      },
      {
        "line": 852,
        "text": "  float cfo_hz_max = INFINITY;"
      },
      {
        "line": 853,
        "text": "  for (uint32_t i = 0; i < nof_symbols - 1; i++) {"
      },
      {
        "line": 854,
        "text": "    float time_diff  = srsran_symbol_distance_s(symbols[i], symbols[i + 1], q->carrier.scs);"
      },
      {
        "line": 855,
        "text": "    float phase_diff = cargf(corr[i + 1] * conjf(corr[i]));"
      },
      {
        "line": 856,
        "text": ""
      },
      {
        "line": 857,
        "text": "    if (isnormal(time_diff)) {"
      },
      {
        "line": 858,
        "text": "      cfo_avg_hz += phase_diff / (2.0f * M_PI * time_diff * (nof_symbols - 1));"
      },
      {
        "line": 859,
        "text": ""
      },
      {
        "line": 860,
        "text": "      // The maximum measured CFO depends on the symbol time difference"
      },
      {
        "line": 861,
        "text": "      cfo_hz_max = SRSRAN_MIN(cfo_hz_max, 1 / time_diff);"
      },
      {
        "line": 862,
        "text": "    }"
      },
      {
        "line": 863,
        "text": "  }"
      },
      {
        "line": 864,
        "text": ""
      },
      {
        "line": 865,
        "text": "  // Store internal CSI"
      },
      {
        "line": 866,
        "text": "  q->csi.rsrp       = rsrp;"
      },
      {
        "line": 867,
        "text": "  q->csi.rsrp_dB    = srsran_convert_power_to_dB(rsrp);"
      },
      {
        "line": 868,
        "text": "  q->csi.epre       = epre;"
      },
      {
        "line": 869,
        "text": "  q->csi.epre_dB    = srsran_convert_power_to_dB(epre);"
      },
      {
        "line": 870,
        "text": "  q->csi.n0         = epre - rsrp;"
      },
      {
        "line": 871,
        "text": "  q->csi.n0_dB      = srsran_convert_power_to_dB(q->csi.n0);"
      },
      {
        "line": 872,
        "text": "  q->csi.snr_dB     = q->csi.rsrp_dB - q->csi.n0_dB;"
      },
      {
        "line": 873,
        "text": "  q->csi.cfo_hz     = cfo_avg_hz;"
      },
      {
        "line": 874,
        "text": "  q->csi.cfo_hz_max = cfo_hz_max;"
      },
      {
        "line": 875,
        "text": "  q->csi.delay_us   = delay_us;"
      },
      {
        "line": 876,
        "text": ""
      },
      {
        "line": 877,
        "text": "  // Write CSI in estimated channel result"
      },
      {
        "line": 878,
        "text": "  chest_res->rsrp               = q->csi.rsrp;"
      },
      {
        "line": 879,
        "text": "  chest_res->rsrp_dbm           = q->csi.rsrp_dB;"
      },
      {
        "line": 880,
        "text": "  chest_res->noise_estimate     = q->csi.n0;"
      },
      {
        "line": 881,
        "text": "  chest_res->noise_estimate_dbm = q->csi.n0_dB;"
      },
      {
        "line": 882,
        "text": "  chest_res->snr_db             = q->csi.snr_dB;"
      }
    ]
  },
