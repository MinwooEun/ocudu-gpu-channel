{
 "definitions": {
  "aggregate_throughput": "Sum over the cell's UEs of UDP payload received per second (app), and of newTx TBS scheduled per second (mac).",
  "decision_latency": "Scheduler decision time per logged slot (`t=` of `Slot decisions`).",
  "delay": "One-way UDP delay, receiver clock minus sender clock (one host clock), of delivered packets.",
  "delay_radio": "Radio-time delay: (link sample at arrival - packet's target sample) / fs. The wall-clock delay (receiver minus sender host clock) is also reported; it scales with the run's radio speed.",
  "gbr_satisfaction": "Not measurable: srsUE carries one default non-GBR QoS flow per PDU session, so no GBR target exists to satisfy.",
  "harq_first_tx_bler": "Share of HARQ transport blocks not delivered by their first transmission (retransmitted or discarded), from the scheduler log. The gNB-metrics BLER counts every transmission.",
  "harq_recovery_rate": "Share of the transport blocks that failed their first transmission which a retransmission then delivered.",
  "harq_residual_bler": "Share of HARQ transport blocks the gNB discarded (maximum retransmissions, retransmission or feedback timeout): what HARQ did not recover and RLC or the application must.",
  "harq_rtt": "Radio time between consecutive transmissions of one transport block (HARQ round trip plus the scheduler's retransmission wait).",
  "harq_tx_per_tb": "Transmissions per HARQ transport block, first one included (1.0 = no retransmission).",
  "jain_fairness": "Jain's index (sum x)^2 / (n sum x^2) over the cell's UEs, for DL throughput, DL throughput divided by offered load, and DL PRB share. 1 = equal, 1/n = one UE takes all.",
  "packet_drop": "Share of sent packets never received (after the drain window).",
  "pdb_violation": "Share of offered packets whose radio-time delay exceeds the UE's 5QI PDB, or never arrived.",
  "per_ue_throughput": "Per UE, UDP payload received per second, against the offered load.",
  "prb_utilization": "Granted PRBs (UE + common) / (106 PRBs x 1000 slots) per radio second.",
  "radio_time": "Segment k = radio second k after measurement sample S0: samples [S0 + k*fs, S0 + (k+1)*fs) of the link concerned. Identical channel updates and offered packets fall in it in every run.",
  "real_time_ratio": "Radio samples per wall second / the cell's sample rate on the gNB receive link (1.0 = real time).",
  "resource_utilization": "PRBs granted (UE + common) / (PRBs in the carrier x slots), from the SCHED log.",
  "spectral_efficiency": "Bits per second per Hz of the 20 MHz carrier: delivered UDP payload (app) and newTx TBS (mac); 'per used PRB' divides TBS by the granted PRB bandwidth only.",
  "starvation": "DL: time from a newTx grant that left data waiting (dl_bo > 0) to the UE's next newTx grant. An event is a wait longer than 20 ms. UL: gap between newTx grants.",
  "throughput_radio": "Delivered UDP payload per radio second (bytes arriving in the segment, mapped through the UE's own link clock). A slow run delivers the same radio-time throughput in more wall time."
 },
