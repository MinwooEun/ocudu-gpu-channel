diff --git a/lib/src/phy/fec/ldpc/simde_shim/immintrin.h b/lib/src/phy/fec/ldpc/simde_shim/immintrin.h
new file mode 100644
index 000000000..f61609dc1
--- /dev/null
+++ b/lib/src/phy/fec/ldpc/simde_shim/immintrin.h
@@ -0,0 +1,8 @@
+/* immintrin.h shim: lets srsRAN's AVX2 LDPC encoder/decoder compile on aarch64 through SIMDe
+ * (256-bit intrinsics emulated with NEON). Only on the include path of the LDPC AVX2 sources
+ * when SRSRAN_LDPC_SIMDE=ON. */
+#ifndef SRSRAN_LDPC_SIMDE_IMMINTRIN_SHIM_H
+#define SRSRAN_LDPC_SIMDE_IMMINTRIN_SHIM_H
+#define SIMDE_ENABLE_NATIVE_ALIASES
+#include <simde/x86/avx2.h>
+#endif
