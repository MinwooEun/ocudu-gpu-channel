diff --git a/lib/src/phy/fec/ldpc/ldpc_dec_c_neon.c b/lib/src/phy/fec/ldpc/ldpc_dec_c_neon.c
new file mode 100644
index 000000000..1191584a0
--- /dev/null
+++ b/lib/src/phy/fec/ldpc/ldpc_dec_c_neon.c
@@ -0,0 +1,417 @@
+/**
