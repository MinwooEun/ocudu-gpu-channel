+
+/*!
+ * \file ldpc_dec_c_neon.c
+ * \brief Definition of the LDPC decoder inner functions working
+ *    with 8-bit integer-valued LLRs, NEON (aarch64) version, any lifting size.
+ *
+ * Local port (minwoo, 2026-10-24) of srsRAN's AVX2 layered min-sum decoder
+ * (ldpc_dec_c_avx2long.c) to NEON. Same algorithm and the same 7/8-bit LLR
+ * saturation rules; each lifted node is stored as ceil(ls/16) 128-bit sub-nodes.
+ * Cyclic shifts are done with two memcpy calls per node instead of lane permutes.
+ *
+ * \author minwoo (port), original algorithm by Software Radio Systems Limited
+ * \date 2026
+ *
+ * \copyright Software Radio Systems Limited
+ */
+
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "ldpc_dec_all.h"
+#include "srsran/phy/fec/ldpc/base_graph.h"
+#include "srsran/phy/utils/vector.h"
+
+#ifdef HAVE_NEON
+
+#include <arm_neon.h>
+
+#define NEON_B_SIZE 16 /*!< \brief Bytes per 128-bit NEON register. */
+
+static const int8_t infinity7 = (1U << 6U) - 1; /*!< \brief 7-bit "infinity" (63). */
+static const int8_t infinity8 = INT8_MAX;        /*!< \brief 8-bit "infinity" (127). */
+
+/*!
+ * \brief Inner registers for the LDPC decoder that works with 8-bit integer-valued LLRs (NEON version).
+ *
+ * All node arrays are laid out as [node][sub-node] int8x16_t vectors; a node has n_subnodes
+ * sub-nodes and the bytes beyond ls in the last sub-node are padding (kept at zero where it matters).
+ */
+struct ldpc_regs_c_neon {
+  int8x16_t* soft_bits;    /*!< \brief A-posteriori log-likelihood ratios, bgN nodes. */
+  int8x16_t* check_to_var; /*!< \brief Check-to-variable messages, bgM x (hrr+1) nodes. */
+  int8x16_t* var_to_check; /*!< \brief Variable-to-check messages, (hrr+1) nodes. */
+  int8x16_t* rotated_v2c;  /*!< \brief Rotated variable-to-check messages, MAX_CNCT nodes. */
+  int8x16_t* this_c2v;     /*!< \brief Helper node for the current check-to-variable message. */
+  int8x16_t* minp_v2c;     /*!< \brief Per-lane minimum |v2c| over the layer, one node. */
+  int8x16_t* mins_v2c;     /*!< \brief Per-lane second minimum |v2c|, one node. */
+  int8x16_t* prod_v2c;     /*!< \brief Per-lane sign product (0x00/0xFF masks), one node. */
+  int8x16_t* min_ix;       /*!< \brief Per-lane index of the minimum, one node. */
+
+  uint8_t  scaling_u8;  /*!< \brief Normalisation factor as a Q0.8 unsigned byte. */
+  uint16_t ls;          /*!< \brief Lifting size. */
+  uint8_t  hrr;         /*!< \brief Number of variable nodes in the high-rate region (before lifting). */
+  uint8_t  bgM;         /*!< \brief Number of check nodes (before lifting). */
+  uint8_t  bgN;         /*!< \brief Number of variable nodes (before lifting). */
+  uint8_t  n_subnodes;  /*!< \brief 128-bit sub-nodes per lifted node. */
+};
+
+static void* neon_alloc(size_t n_vectors)
+{
+  void* p = NULL;
+  if (posix_memalign(&p, 64, n_vectors * sizeof(int8x16_t)) != 0) {
+    return NULL;
+  }
+  memset(p, 0, n_vectors * sizeof(int8x16_t));
+  return p;
+}
+
+static void inner_var_to_check_c_neon(const int8x16_t* x, const int8x16_t* y, int8x16_t* z, int8_t clip, uint32_t len);
+static void rotate_node_right(const int8x16_t* in, int8x16_t* out, uint16_t shift, uint16_t ls, uint8_t n_subnodes);
+
+void* create_ldpc_dec_c_neon(uint8_t bgN, uint8_t bgM, uint16_t ls, float scaling_fctr)
+{
+  struct ldpc_regs_c_neon* vp = NULL;
+
+  uint8_t  bgK = bgN - bgM;
+  uint16_t hrr = bgK + 4;
+
+  if ((vp = SRSRAN_MEM_ALLOC(struct ldpc_regs_c_neon, 1)) == NULL) {
+    return NULL;
+  }
+  SRSRAN_MEM_ZERO(vp, struct ldpc_regs_c_neon, 1);
+
+  uint8_t n_subnodes = ls / NEON_B_SIZE + ((ls % NEON_B_SIZE) > 0);
+
+  if ((vp->soft_bits = neon_alloc((size_t)bgN * n_subnodes)) == NULL) {
+    delete_ldpc_dec_c_neon(vp);
+    return NULL;
+  }
+  if ((vp->check_to_var = neon_alloc((size_t)(hrr + 1) * bgM * n_subnodes)) == NULL) {
+    delete_ldpc_dec_c_neon(vp);
+    return NULL;
+  }
+  if ((vp->var_to_check = neon_alloc((size_t)(hrr + 1) * n_subnodes)) == NULL) {
+    delete_ldpc_dec_c_neon(vp);
+    return NULL;
+  }
+  if ((vp->rotated_v2c = neon_alloc((size_t)MAX_CNCT * n_subnodes)) == NULL) {
+    delete_ldpc_dec_c_neon(vp);
+    return NULL;
+  }
+  if ((vp->this_c2v = neon_alloc(n_subnodes)) == NULL) {
+    delete_ldpc_dec_c_neon(vp);
+    return NULL;
+  }
+  if ((vp->minp_v2c = neon_alloc(n_subnodes)) == NULL) {
+    delete_ldpc_dec_c_neon(vp);
+    return NULL;
+  }
+  if ((vp->mins_v2c = neon_alloc(n_subnodes)) == NULL) {
+    delete_ldpc_dec_c_neon(vp);
+    return NULL;
+  }
+  if ((vp->prod_v2c = neon_alloc(n_subnodes)) == NULL) {
+    delete_ldpc_dec_c_neon(vp);
+    return NULL;
+  }
+  if ((vp->min_ix = neon_alloc(n_subnodes)) == NULL) {
+    delete_ldpc_dec_c_neon(vp);
+    return NULL;
+  }
+
+  vp->bgM        = bgM;
+  vp->bgN        = bgN;
+  vp->hrr        = hrr;
+  vp->ls         = ls;
+  vp->n_subnodes = n_subnodes;
+
+  // Q0.8 scaling: floor(a * s) for a in [0, 127] matches the AVX2 (a * (s + 2^-16) * 65535) >> 16 result for s = 0.8.
+  float s = scaling_fctr * 256.0F + 0.5F;
+  if (s < 1.0F) {
+    s = 1.0F;
+  }
+  if (s > 255.0F) {
+    s = 255.0F;
+  }
+  vp->scaling_u8 = (uint8_t)s;
+
+  return vp;
+}
+
+void delete_ldpc_dec_c_neon(void* p)
+{
+  struct ldpc_regs_c_neon* vp = p;
+
+  if (vp == NULL) {
+    return;
+  }
+  free(vp->min_ix);
+  free(vp->prod_v2c);
+  free(vp->mins_v2c);
+  free(vp->minp_v2c);
+  free(vp->this_c2v);
+  free(vp->rotated_v2c);
+  free(vp->var_to_check);
+  free(vp->check_to_var);
+  free(vp->soft_bits);
+  free(vp);
+}
+
+int init_ldpc_dec_c_neon(void* p, const int8_t* llrs, uint16_t ls)
+{
+  struct ldpc_regs_c_neon* vp = p;
+
+  if (p == NULL) {
+    return -1;
+  }
+
+  const uint32_t node_bytes = (uint32_t)vp->n_subnodes * NEON_B_SIZE;
+  int8_t*        sb         = (int8_t*)vp->soft_bits;
+
+  // the first 2 x LS bits of the codeword are not sent
+  memset(sb, 0, 2 * node_bytes);
+  for (int i = 2; i < vp->bgN; i++) {
+    int8_t* node = sb + (size_t)i * node_bytes;
+    memcpy(node, llrs + (size_t)(i - 2) * ls, ls);
+    if (node_bytes > ls) {
+      memset(node + ls, 0, node_bytes - ls);
+    }
+  }
+
+  memset(vp->check_to_var, 0, (size_t)(vp->hrr + 1) * vp->bgM * vp->n_subnodes * sizeof(int8x16_t));
+  memset(vp->var_to_check, 0, (size_t)(vp->hrr + 1) * vp->n_subnodes * sizeof(int8x16_t));
+  memset(vp->min_ix, 0, (size_t)vp->n_subnodes * sizeof(int8x16_t));
+
+  return 0;
+}
+
+int update_ldpc_var_to_check_c_neon(void* p, int i_layer)
+{
+  struct ldpc_regs_c_neon* vp = p;
+
+  if (p == NULL) {
+    return -1;
+  }
+
+  int8x16_t* this_check_to_var = vp->check_to_var + (size_t)i_layer * (vp->hrr + 1) * vp->n_subnodes;
+
+  // Update the high-rate region.
+  inner_var_to_check_c_neon(
+      vp->soft_bits, this_check_to_var, vp->var_to_check, infinity7, (uint32_t)vp->hrr * vp->n_subnodes);
+
+  if (i_layer >= 4) {
+    // Update the extension region.
+    inner_var_to_check_c_neon(vp->soft_bits + (size_t)(vp->hrr + i_layer - 4) * vp->n_subnodes,
+                              this_check_to_var + (size_t)vp->hrr * vp->n_subnodes,
+                              vp->var_to_check + (size_t)vp->hrr * vp->n_subnodes,
+                              infinity7,
+                              vp->n_subnodes);
+  }
+
+  return 0;
+}
+
+int update_ldpc_check_to_var_c_neon(void*           p,
+                                    int             i_layer,
+                                    const uint16_t* this_pcm,
+                                    const int8_t (*these_var_indices)[MAX_CNCT])
+{
+  struct ldpc_regs_c_neon* vp = p;
+
+  if (p == NULL) {
+    return -1;
+  }
+
+  const int n_sub = vp->n_subnodes;
+
+  const int8x16_t int8_max = vdupq_n_s8(INT8_MAX);
+  for (int j = 0; j < n_sub; j++) {
+    vp->minp_v2c[j] = int8_max;
+    vp->mins_v2c[j] = int8_max;
+    vp->prod_v2c[j] = vdupq_n_s8(0);
+  }
+
+  // First pass: rotate, accumulate the sign product and the two smallest magnitudes per lane.
+  int8_t current_var_index = (*these_var_indices)[0];
+  for (int i = 0; (current_var_index != -1) && (i < MAX_CNCT); i++) {
+    uint16_t shift      = this_pcm[current_var_index];
+    int      i_v2c_base = ((current_var_index <= vp->hrr) ? current_var_index : vp->hrr) * n_sub;
+
+    int8x16_t*      this_rotated_v2c = vp->rotated_v2c + (size_t)i * n_sub;
+    const int8x16_t current_ix       = vdupq_n_s8((int8_t)i);
+
+    rotate_node_right(vp->var_to_check + i_v2c_base, this_rotated_v2c, shift, vp->ls, vp->n_subnodes);
+
+    for (int j = 0; j < n_sub; j++) {
+      int8x16_t v = this_rotated_v2c[j];
+      // sign product: flip the lanes where v is strictly negative
+      uint8x16_t neg = vcltzq_s8(v);
+      vp->prod_v2c[j] = veorq_s8(vp->prod_v2c[j], vreinterpretq_s8_u8(neg));
+
+      int8x16_t a = vqabsq_s8(v);
+      // new minimum?
+      uint8x16_t lt_minp = vcgtq_s8(vp->minp_v2c[j], a);
+      int8x16_t  help    = vbslq_s8(lt_minp, vp->minp_v2c[j], a); // max(a, minp) = the displaced value
+      vp->minp_v2c[j]    = vbslq_s8(lt_minp, a, vp->minp_v2c[j]);
+      vp->min_ix[j]      = vbslq_s8(lt_minp, current_ix, vp->min_ix[j]);
+      // new second minimum?
+      uint8x16_t lt_mins = vcgtq_s8(vp->mins_v2c[j], a);
+      vp->mins_v2c[j]    = vbslq_s8(lt_mins, help, vp->mins_v2c[j]);
+    }
+    current_var_index = (*these_var_indices)[(i + 1) % MAX_CNCT];
+  }
+
+  // Second pass: build each check-to-variable message and rotate it back.
+  int8x16_t* this_check_to_var = vp->check_to_var + (size_t)i_layer * (vp->hrr + 1) * n_sub;
+  const uint8x8_t sf           = vdup_n_u8(vp->scaling_u8);
+
+  current_var_index = (*these_var_indices)[0];
+  for (int i = 0; (current_var_index != -1) && (i < MAX_CNCT); i++) {
+    uint16_t shift      = this_pcm[current_var_index];
+    int      i_v2c_base = ((current_var_index <= vp->hrr) ? current_var_index : vp->hrr) * n_sub;
+
+    const int8x16_t* this_rotated_v2c = vp->rotated_v2c + (size_t)i * n_sub;
+    const int8x16_t  current_ix       = vdupq_n_s8((int8_t)i);
+
+    for (int j = 0; j < n_sub; j++) {
+      // final sign = sign(v2c) xor product of all signs in the layer
+      uint8x16_t final_neg = veorq_u8(vcltzq_s8(this_rotated_v2c[j]), vreinterpretq_u8_s8(vp->prod_v2c[j]));
+
+      // magnitude: the second minimum for the lane that holds the minimum, the minimum otherwise
+      uint8x16_t is_min = vceqq_s8(current_ix, vp->min_ix[j]);
+      int8x16_t  mag    = vbslq_s8(is_min, vp->mins_v2c[j], vp->minp_v2c[j]);
+
+      // normalised min-sum: floor(mag * scaling) with mag in [0, 127]
+      uint8x16_t magu = vreinterpretq_u8_s8(mag);
+      uint16x8_t lo   = vmull_u8(vget_low_u8(magu), sf);
+      uint16x8_t hi   = vmull_u8(vget_high_u8(magu), sf);
+      int8x16_t  scaled = vreinterpretq_s8_u8(vcombine_u8(vshrn_n_u16(lo, 8), vshrn_n_u16(hi, 8)));
+
+      vp->this_c2v[j] = vbslq_s8(final_neg, vnegq_s8(scaled), scaled);
+    }
+    // rotating right LS - shift positions is the same as rotating left shift positions
+    rotate_node_right(vp->this_c2v, this_check_to_var + i_v2c_base, (uint16_t)(vp->ls - shift), vp->ls, vp->n_subnodes);
+
+    current_var_index = (*these_var_indices)[(i + 1) % MAX_CNCT];
+  }
+
+  return 0;
+}
+
+int update_ldpc_soft_bits_c_neon(void* p, int i_layer, const int8_t (*these_var_indices)[MAX_CNCT])
+{
+  struct ldpc_regs_c_neon* vp = p;
+  if (p == NULL) {
+    return -1;
+  }
+
+  const int        n_sub             = vp->n_subnodes;
+  const int8x16_t* this_check_to_var = vp->check_to_var + (size_t)i_layer * (vp->hrr + 1) * n_sub;
+
+  const int8x16_t infty7     = vdupq_n_s8(infinity7);
+  const int8x16_t neg_infty7 = vdupq_n_s8(-infinity7);
+  const int8x16_t infty8     = vdupq_n_s8(infinity8);
+  const int8x16_t neg_infty8 = vdupq_n_s8(-infinity8);
+
+  int8_t current_var_index = (*these_var_indices)[0];
+  for (int i = 0; (current_var_index != -1) && (i < MAX_CNCT); i++) {
+    int        i_bit_base = ((current_var_index <= vp->hrr) ? current_var_index : vp->hrr) * n_sub;
+    int8x16_t* sb         = vp->soft_bits + (size_t)current_var_index * n_sub;
+    for (int j = 0; j < n_sub; j++) {
+      int8x16_t tmp = vqaddq_s8(this_check_to_var[i_bit_base + j], vp->var_to_check[i_bit_base + j]);
+      // tmp = (tmp > infty7) ? infty8 : tmp
+      tmp = vbslq_s8(vcgtq_s8(tmp, infty7), infty8, tmp);
+      // tmp = (tmp < -infty7) ? -infty8 : tmp
+      sb[j] = vbslq_s8(vcgtq_s8(neg_infty7, tmp), neg_infty8, tmp);
+    }
+    current_var_index = (*these_var_indices)[(i + 1) % MAX_CNCT];
+  }
+
+  return 0;
+}
+
+int extract_ldpc_message_c_neon(void* p, uint8_t* message, uint16_t liftK)
+{
+  if (p == NULL) {
+    return -1;
+  }
+  struct ldpc_regs_c_neon* vp = p;
+
+  const uint32_t node_bytes = (uint32_t)vp->n_subnodes * NEON_B_SIZE;
+  const int8_t*  sb         = (const int8_t*)vp->soft_bits;
+
+  for (int i = 0; i < liftK / vp->ls; i++) {
+    const int8_t* node = sb + (size_t)i * node_bytes;
+    for (int k = 0; k < vp->ls; k++) {
+      message[i * vp->ls + k] = (node[k] < 0);
+    }
+  }
+  return 0;
+}
+
+/*!
+ * z = clip(x - y) with saturation, and x = +/-infinity8 forces z = +/-infinity8.
+ */
+static void inner_var_to_check_c_neon(const int8x16_t* x, const int8x16_t* y, int8x16_t* z, int8_t clip, uint32_t len)
+{
+  const int8x16_t clip_v     = vdupq_n_s8(clip);
+  const int8x16_t neg_clip_v = vdupq_n_s8((int8_t)(-clip));
+  const int8x16_t infty8     = vdupq_n_s8(infinity8);
+  const int8x16_t neg_infty8 = vdupq_n_s8(-infinity8);
+
+  for (uint32_t i = 0; i < len; i++) {
+    int8x16_t xv = x[i];
+    int8x16_t zv = vqsubq_s8(xv, y[i]);
+    // z = (z > clip) ? clip : z ; z = (z < -clip) ? -clip : z
+    zv = vminq_s8(zv, clip_v);
+    zv = vmaxq_s8(zv, neg_clip_v);
+    // z = (x < infinity) ? z : infinity    (x == 127 -> 127)
+    zv = vbslq_s8(vcgtq_s8(infty8, xv), zv, infty8);
+    // z = (x > -infinity) ? z : -infinity  (x <= -127 -> -127)
+    z[i] = vbslq_s8(vcgtq_s8(xv, neg_infty8), zv, neg_infty8);
+  }
+}
+
+/*!
+ * out[k] = in[(k + shift) mod ls] for k < ls; the padding bytes of out are zeroed.
+ */
+static void rotate_node_right(const int8x16_t* in, int8x16_t* out, uint16_t shift, uint16_t ls, uint8_t n_subnodes)
+{
+  const int8_t* src = (const int8_t*)in;
+  int8_t*       dst = (int8_t*)out;
+  if (shift >= ls) {
+    shift = (uint16_t)(shift % ls);
+  }
+  memcpy(dst, src + shift, (size_t)(ls - shift));
+  if (shift != 0) {
+    memcpy(dst + (ls - shift), src, shift);
+  }
+  const uint32_t node_bytes = (uint32_t)n_subnodes * NEON_B_SIZE;
+  if (node_bytes > ls) {
+    memset(dst + ls, 0, node_bytes - ls);
+  }
+}
+
+#endif // HAVE_NEON
