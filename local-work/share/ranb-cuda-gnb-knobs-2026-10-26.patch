@@ -246,6 +246,36 @@ if [[ -n "${gnb_rx_gain}" ]]; then
   done
 fi
 for gnb_id in gnb0 gnb1; do
+  # Local knob (2026-10-26): CUDA-accelerated OCUDU gNB, same keys as scripts/cuda/render-cuda-1x1-configs.py.
+  if [[ -n "${OCUDU_NATIVE_SB_GNB_ACCELERATION:-}" ]]; then
+    /usr/bin/python3 - "${config_dir}/${gnb_id}.yaml" "${OCUDU_NATIVE_SB_GNB_ACCELERATION}" "${OCUDU_NATIVE_CUDA_GRID_MODE:-}" <<'PY2' || usage_error "could not append the CUDA acceleration keys to ${gnb_id}.yaml"
+import sys
+path, stage, override = sys.argv[1:]
+stages = ("disabled", "low-phy-rx", "low-phy-tx", "pusch", "pdsch", "prach", "all")
+if stage not in stages: raise SystemExit(f"unknown CUDA acceleration stage: {stage}")
+index = stages.index(stage)
+upper = {"pusch_acceleration_mode": "disabled", "pdsch_acceleration_mode": "disabled", "prach_acceleration_mode": "disabled", "srs_acceleration_mode": "disabled"}
+lower = {"low_phy_rx_acceleration_mode": "disabled", "low_phy_tx_acceleration_mode": "disabled", "low_phy_prach_demodulation_acceleration_mode": "disabled"}
+order = [("lower", "low_phy_rx_acceleration_mode"), ("lower", "low_phy_tx_acceleration_mode"), ("upper", "pusch_acceleration_mode"), ("upper", "pdsch_acceleration_mode"), ("upper", "prach_acceleration_mode"), ("upper", "srs_acceleration_mode")]
+for where, key in order[:index]: (upper if where == "upper" else lower)[key] = "enabled"
+if index >= 5: lower["low_phy_prach_demodulation_acceleration_mode"] = "enabled"
+import os
+if os.environ.get("OCUDU_NATIVE_SB_CUDA_LOWER") in ("disabled", "enabled"):
+    lower["low_phy_rx_acceleration_mode"] = lower["low_phy_tx_acceleration_mode"] = os.environ["OCUDU_NATIVE_SB_CUDA_LOWER"]
+if os.environ.get("OCUDU_NATIVE_SB_CUDA_LOWER_PRACH") in ("disabled", "enabled"): lower["low_phy_prach_demodulation_acceleration_mode"] = os.environ["OCUDU_NATIVE_SB_CUDA_LOWER_PRACH"]
+ul_grid = "managed" if index >= 1 else "pinned"; dl_grid = "managed" if index >= 2 else "pinned"
+if override:
+    if override not in ("auto", "pinned", "managed"): raise SystemExit(f"invalid OCUDU_NATIVE_CUDA_GRID_MODE: {override}")
+    ul_grid = dl_grid = override
+text = open(path).read()
+if "expert_phy:" in text or "  expert_cfg:" in text: raise SystemExit("gnb yaml already carries expert settings")
+if text.count("ru_sdr:\n") != 1: raise SystemExit("expected exactly one ru_sdr section")
+ru = "".join(f"    {k}: {v}\n" for k, v in lower.items())
+text = text.replace("ru_sdr:\n", "ru_sdr:\n  expert_cfg:\n" + ru, 1)
+text += "\nexpert_phy:\n" + "".join(f"  {k}: {v}\n" for k, v in upper.items()) + f"  ul_cuda_visible_grid_mode: {ul_grid}\n  dl_cuda_visible_grid_mode: {dl_grid}\n"
+open(path, "w").write(text)
+PY2
+  fi
   "${gnb_binary}" -c "${config_dir}/${gnb_id}.yaml" --dryrun >"${log_dir}/${gnb_id}-dryrun.log" 2>&1 || {
     tail -20 "${log_dir}/${gnb_id}-dryrun.log" >&2; usage_error "${gnb_id} dry run failed"
   }
