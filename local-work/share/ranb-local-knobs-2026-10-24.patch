diff --git a/use_cases/ran_benchmark/run-single-cell-policy-inner.sh b/use_cases/ran_benchmark/run-single-cell-policy-inner.sh
index ae11d41..1933a93 100755
--- a/use_cases/ran_benchmark/run-single-cell-policy-inner.sh
+++ b/use_cases/ran_benchmark/run-single-cell-policy-inner.sh
@@ -298,8 +298,11 @@ for index in "${!ue_ids[@]}"; do
   id="${ue_ids[index]}"
   date -u +%s%3N >"${log_dir}/srsue-${id}.start_unix_ms"
   # Distinct contention preambles for up to 16 UEs (definitions.single_cell_prach_preamble).
+  # local knob (minwoo 2026-10-24): SINGLE_CELL_CPUS_UE<i> pins one UE to its own CPU set
