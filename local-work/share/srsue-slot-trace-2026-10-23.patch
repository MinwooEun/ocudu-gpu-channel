diff --git a/lib/include/srsran/phy/utils/slot_trace.h b/lib/include/srsran/phy/utils/slot_trace.h
new file mode 100644
index 000000000..7e69cf7e6
--- /dev/null
+++ b/lib/include/srsran/phy/utils/slot_trace.h
@@ -0,0 +1,58 @@
+/* slot_trace.h -- per-translation-unit CSV trace of per-slot timing for srsUE lock-step analysis.
+ * Enabled by SRSUE_SLOT_TRACE_DIR=<dir>; writes <dir>/<pid>-<tag>.csv with columns t_ns,ev,tti,a,b,c
+ * (t_ns = CLOCK_MONOTONIC, same clock as the broker hop trace). Diagnostic only. */
+#ifndef SRSRAN_SLOT_TRACE_H
+#define SRSRAN_SLOT_TRACE_H
+#include <pthread.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <time.h>
+#include <unistd.h>
+
+static inline int64_t st_now_ns(void)
+{
+  struct timespec ts;
+  clock_gettime(CLOCK_MONOTONIC, &ts);
+  return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
+}
+static FILE*          st_f_ __attribute__((unused))    = NULL;
+static pthread_once_t st_once_ __attribute__((unused)) = PTHREAD_ONCE_INIT;
+static const char*    st_tag_ __attribute__((unused))  = "x";
+static void __attribute__((unused)) st_flush_(void)
+{
+  if (st_f_ != NULL) {
+    fflush(st_f_);
+  }
+}
+static void __attribute__((unused)) st_open_(void)
+{
+  const char* d = getenv("SRSUE_SLOT_TRACE_DIR");
+  if (d == NULL || *d == '\0') {
+    return;
+  }
+  char p[1024];
+  snprintf(p, sizeof(p), "%s/%d-%s.csv", d, (int)getpid(), st_tag_);
+  st_f_ = fopen(p, "w");
+  if (st_f_ == NULL) {
+    return;
+  }
+  setvbuf(st_f_, NULL, _IOFBF, 1 << 20);
+  fprintf(st_f_, "t_ns,ev,tti,a,b,c\n");
+  atexit(st_flush_);
+}
+static inline void st_ev(const char* tag, const char* ev, uint32_t tti, long long a, long long b, long long c)
+{
+  static unsigned long n = 0; /* benign race: only paces fflush */
+  st_tag_                = tag;
+  pthread_once(&st_once_, st_open_);
+  if (st_f_ == NULL) {
+    return;
+  }
+  fprintf(st_f_, "%lld,%s,%u,%lld,%lld,%lld\n", (long long)st_now_ns(), ev, tti, a, b, c);
+  if ((++n & 1023) == 0) {
+    fflush(st_f_);
+  }
+}
+#define ST_US(t0) ((long long)((st_now_ns() - (t0)) / 1000))
+#endif
