+  int fp_flag = 1;//0: float point calc 1: Fixed point calc
+
+  // The fixed-point path computes det(A) and adj(A)*(H^H y) = det(A)*x with
+  // mult_complex_vectors, which keeps only 16 bits of each (product >> shift)
+  // and wraps instead of saturating. With the stock shift (log2_maxh - 1) the
+  // products leave int16 once the received power is high enough, so the
+  // equalised symbols and the LLR thresholds (det * QAM amplitude) change
+  // sign. Pick the shift from the data instead: every product is bounded by
+  // about 2 * max|A|^2 * |x|, so shift until max|A|^2 >> s <= 2^13. Output
+  // and thresholds scale together, so the LLR geometry is unchanged; when no
+  // extra shift is needed the result is bit-identical to the stock shift.
+  int shift_eq = shift - (fp_flag == 1 ? 1 : 0);
+  {
+    int amax = 0;
+    for (int rtx = 0; rtx < nl; rtx++)
+      for (int ctx = 0; ctx < nl; ctx++) {
+        const c16_t *a = conjH_H_elements[0][ctx][rtx];
+        for (int i = 0; i < 12 * (int)nb_rb_0; i++) {
+          const int m = cmax(abs(a[i].r), abs(a[i].i));
+          if (m > amax)
+            amax = m;
+        }
+      }
+    const int64_t a2 = (int64_t)amax * amax;
+    int need = 0;
+    while ((a2 >> need) > (1 << 13))
+      need++;
+    // mult_complex_vectors takes a shift of at most 16.
+    if (need > 16)
+      need = 16;
+    if (need > shift_eq)
+      shift_eq = need;
+  }
