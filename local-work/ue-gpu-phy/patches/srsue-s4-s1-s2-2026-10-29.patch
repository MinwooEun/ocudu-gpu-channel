+extern "C" int srsran_ue_dl_cuda_set_carrier(srsran_ue_dl_cuda_t* q, uint32_t nof_prb, uint32_t symbol_sz)
+{
+  if (q == nullptr || nof_prb == 0 || nof_prb > q->max_prb || symbol_sz == 0 || symbol_sz > 4096) {
+    return -1;
+  }
+  q->nof_prb   = nof_prb;
+  q->symbol_sz = symbol_sz;
+  if (q->plan_ok && q->plan_N == symbol_sz) {
+    return 0;
+  }
+  if (q->plan_ok) {
+    cufftDestroy(q->plan);
+    q->plan_ok = false;
+  }
+  if (cufftPlan1d(&q->plan, (int)symbol_sz, CUFFT_C2C, UEDL_NSYMB) != CUFFT_SUCCESS) {
+    fprintf(stderr, "[ue_dl_cuda] cufftPlan1d(%u x %d) failed\n", symbol_sz, UEDL_NSYMB);
+    return -1;
+  }
+  cufftSetStream(q->plan, q->stream);
+  q->plan_ok = true;
+  q->plan_N  = symbol_sz;
+  // warm up the plan so the first slot does not pay for kernel loading
+  cudaMemsetAsync(q->fft_in, 0, sizeof(float2) * UEDL_NSYMB * symbol_sz, q->stream);
+  cufftExecC2C(q->plan, (cufftComplex*)q->fft_in, (cufftComplex*)q->fft_out, CUFFT_FORWARD);
+  cudaStreamSynchronize(q->stream);
+  if (q->verbose) {
+    fprintf(stderr, "[ue_dl_cuda] carrier nof_prb=%u symbol_sz=%u: cuFFT plan ready\n", nof_prb, symbol_sz);
+  }
+  return 0;
+}
+
+static int uedl_device_ptr(srsran_ue_dl_cuda_t* q, const void* host, size_t len, const void** dev)
+{
+  if (q->reg_ptr == host && q->reg_len >= len) {
+    *dev = q->reg_dev;
+    return 0;
+  }
+  if (q->reg_ptr) {
+    cudaHostUnregister((void*)q->reg_ptr);
+    q->reg_ptr = nullptr;
+  }
+  // Register the worker's receive buffer once; on the GB10 (pageable access) the host pointer is also usable.
+  void* d = nullptr;
+  if (cudaHostRegister((void*)host, len, cudaHostRegisterMapped) == cudaSuccess &&
+      cudaHostGetDevicePointer(&d, (void*)host, 0) == cudaSuccess) {
+    q->reg_ptr = host;
+    q->reg_len = len;
+    q->reg_dev = d;
+    *dev       = d;
+    return 0;
+  }
+  cudaGetLastError();
+  cudaDeviceProp prop{};
+  int            dev_id = 0;
+  cudaGetDevice(&dev_id);
+  cudaGetDeviceProperties(&prop, dev_id);
+  if (prop.pageableMemoryAccess) {
+    *dev = host;
+    return 0;
+  }
+  return -1;
+}
+
+extern "C" int srsran_ue_dl_cuda_fft(srsran_ue_dl_cuda_t*            q,
+                                     const float*                    in,
+                                     const srsran_ue_dl_cuda_ofdm_t* o,
+                                     float*                          grid)
+{
+  if (q == nullptr || !(q->mode & SRSRAN_UE_DL_CUDA_FFT) || !q->plan_ok || o == nullptr || in == nullptr ||
+      grid == nullptr) {
+    return -1;
+  }
+  if (o->symbol_sz != q->plan_N || o->nof_re > q->nof_prb * 12 || o->nof_re == 0) {
+    return -1;
+  }
+  const int N      = (int)o->symbol_sz;
+  size_t    in_len = sizeof(float2) * (size_t)N * 15;
+  const void* d_in = nullptr;
+  if (uedl_device_ptr(q, in, in_len, &d_in) < 0) {
+    return -1;
+  }
+  memcpy(q->phase, o->phase, sizeof(float2) * UEDL_NSYMB);
+  float norm = o->normalize ? (1.0f / sqrtf((float)N)) : 1.0f;
+  int   n1   = UEDL_NSYMB * N;
+  int   n2   = UEDL_NSYMB * (int)o->nof_re;
+  k_gather<<<(n1 + 255) / 256, 256, 0, q->stream>>>((const float2*)d_in, q->fft_in, N, (int)o->cp1, (int)o->cp2, (int)o->slot_sz, (int)o->window_offset_n);
+  if (cufftExecC2C(q->plan, (cufftComplex*)q->fft_in, (cufftComplex*)q->fft_out, CUFFT_FORWARD) != CUFFT_SUCCESS) {
+    fprintf(stderr, "[ue_dl_cuda] cufftExecC2C failed\n");
+    return -1;
+  }
+  k_post<<<(n2 + 255) / 256, 256, 0, q->stream>>>(q->fft_out, (float2*)grid, q->grid_bf16, N, (int)o->nof_re, (int)o->dc, (float)o->window_offset_n, q->phase, norm);
+  UEDL_CK(uedl_sync(q));
+  return 0;
+}
+
+extern "C" int srsran_ue_dl_cuda_grid_to_bf16(srsran_ue_dl_cuda_t* q, const float* grid, uint32_t nof_prb)
+{
+  if (q == nullptr || grid == nullptr || nof_prb == 0 || nof_prb > q->max_prb) {
+    return -1;
+  }
+  const void* d_grid = nullptr;
+  int         n      = (int)(UEDL_NSYMB * nof_prb * 12);
+  // a managed grid can be read directly; any other host grid is registered
+  cudaPointerAttributes attr{};
+  if (cudaPointerGetAttributes(&attr, grid) == cudaSuccess && attr.type == cudaMemoryTypeManaged) {
+    d_grid = grid;
+  } else {
+    cudaGetLastError();
+    if (uedl_device_ptr(q, grid, sizeof(float2) * (size_t)n, &d_grid) < 0) {
+      return -1;
+    }
+  }
+  k_f2bf<<<(n + 255) / 256, 256, 0, q->stream>>>((const float2*)d_grid, q->grid_bf16, n);
+  UEDL_CK(uedl_sync(q));
+  return 0;
+}
