+// ------------------------------------------------------------------------------------------------------------------
+// Kernels
+// ------------------------------------------------------------------------------------------------------------------
+
+__device__ __forceinline__ uint32_t pack_cbf16(float re, float im)
+{
+  __nv_bfloat16 r = __float2bfloat16(re);
+  __nv_bfloat16 i = __float2bfloat16(im);
+  return (uint32_t)__bfloat16_as_ushort(r) | ((uint32_t)__bfloat16_as_ushort(i) << 16);
+}
+
+/// CP removal / DFT window placement: 14 symbols of N samples, contiguous.
+__global__ void k_gather(const float2* __restrict__ in, float2* __restrict__ out, int N, int cp1, int cp2, int slot_sz, int woff)
+{
+  int idx = blockIdx.x * blockDim.x + threadIdx.x;
+  if (idx >= UEDL_NSYMB * N) {
+    return;
+  }
+  int l     = idx / N;
+  int n     = idx - l * N;
+  int s     = l / 7;
+  int i     = l - s * 7;
+  int start = cp1 + s * slot_sz + i * (N + cp2) - woff;
+  out[idx]  = in[start + n];
+}
+
+/// FFT shift, DC handling, window-offset phase ramp, phase compensation, normalisation; float + bf16 outputs.
+__global__ void k_post(const float2* __restrict__ f,
+                       float2* __restrict__ grid,
+                       uint32_t* __restrict__ gridbf,
+                       int N,
+                       int nof_re,
+                       int dc,
+                       float woff,
+                       const float2* __restrict__ phase,
+                       float norm)
+{
+  int idx = blockIdx.x * blockDim.x + threadIdx.x;
+  if (idx >= UEDL_NSYMB * nof_re) {
+    return;
+  }
+  int    l   = idx / nof_re;
+  int    k   = idx - l * nof_re;
+  int    bin = (k < nof_re / 2) ? (N - nof_re / 2 + k) : (k - nof_re / 2 + dc);
+  float2 v   = f[l * N + bin];
+  if (woff != 0.0f) {
+    float s, c;
+    sincospif(2.0f * woff * (float)bin / (float)N, &s, &c);
+    v = make_float2(v.x * c - v.y * s, v.x * s + v.y * c);
+  }
+  // multiply by conj(phase[l]) * norm
+  float2 p = phase[l];
+  float2 o = make_float2((v.x * p.x + v.y * p.y) * norm, (v.y * p.x - v.x * p.y) * norm);
+  grid[idx]   = o;
+  gridbf[idx] = pack_cbf16(o.x, o.y);
+}
+
+__global__ void k_f2bf(const float2* __restrict__ grid, uint32_t* __restrict__ gridbf, int n)
+{
+  int idx = blockIdx.x * blockDim.x + threadIdx.x;
+  if (idx < n) {
+    float2 v    = grid[idx];
+    gridbf[idx] = pack_cbf16(v.x, v.y);
+  }
+}
