+/**
+ * Rate dematching, one thread per output LLR of every code block. Mirrors srsran_ldpc_rm_rx_c(): the e-th
+ * received LLR of a code block (after bit de-interleaving) lands on the e-th non-filler position of the circular
+ * buffer walked from k0; repetitions are accumulated and clamped; filler positions get a large positive LLR; the
+ * first 2Z (punctured) positions and positions beyond Ncb are zero.
+ */
+__global__ void k_dematch(const __half* __restrict__ llrs,
+                          const uint32_t* __restrict__ E_cb,
+                          const uint32_t* __restrict__ off_cb,
+                          __half* __restrict__ out,
+                          int nof_cb,
+                          int N_full,
+                          int Z,
+                          int Ncb,
+                          int k0,
+                          int ini,
+                          int end,
+                          int Qm)
+{
+  int idx = blockIdx.x * blockDim.x + threadIdx.x;
+  if (idx >= nof_cb * N_full) {
+    return;
+  }
+  int cb  = idx / N_full;
+  int p   = idx - cb * N_full;
+  int pos = p - 2 * Z;
+  float val = 0.0f;
+  if (pos >= 0 && pos < Ncb) {
+    if (pos >= ini && pos < end) {
+      val = UEDL_FILLER_LLR;
+    } else {
+      int kk = (k0 >= ini && k0 < end) ? end : k0; // a start inside the fillers equals a start right after them
+      int rank;
+      if (kk < ini) {
+        // walk: [kk,ini) [end,Ncb) [0,kk)
+        if (pos >= kk && pos < ini) {
+          rank = pos - kk;
+        } else if (pos >= end) {
+          rank = (ini - kk) + (pos - end);
+        } else {
+          rank = (ini - kk) + (Ncb - end) + pos;
+        }
+      } else {
+        // kk >= end, walk: [kk,Ncb) [0,ini) [end,kk)
+        if (pos >= kk) {
+          rank = pos - kk;
+        } else if (pos < ini) {
+          rank = (Ncb - kk) + pos;
+        } else {
+          rank = (Ncb - kk) + ini + (pos - end);
+        }
+      }
+      int E    = (int)E_cb[cb];
+      int off  = (int)off_cb[cb];
+      int m    = Ncb - (end - ini);
+      int cols = E / Qm;
+      float acc = 0.0f;
+      for (int k = rank; k < E; k += m) {
+        int i = k / cols;
+        int j = k - i * cols;
+        acc += __half2float(llrs[off + j * Qm + i]);
+      }
+      val = fminf(fmaxf(acc, -UEDL_LLR_CLAMP), UEDL_LLR_CLAMP);
+    }
+  }
+  out[idx] = __float2half(val);
+}
