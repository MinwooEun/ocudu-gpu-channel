+static uint32_t uedl_mode_from_env()
+{
+  const char* e = getenv("SRSRAN_UE_DL_CUDA");
+  if (e == nullptr || e[0] == '\0' || e[0] == '0') {
+    return 0;
+  }
+  uint32_t m = 0;
+  if (strstr(e, "all")) {
+    m = SRSRAN_UE_DL_CUDA_FFT | SRSRAN_UE_DL_CUDA_PDSCH;
+  }
+  if (strstr(e, "fft")) {
+    m |= SRSRAN_UE_DL_CUDA_FFT;
+  }
+  if (strstr(e, "pdsch")) {
+    m |= SRSRAN_UE_DL_CUDA_PDSCH;
+  }
+  return m;
+}
+
+extern "C" srsran_ue_dl_cuda_t* srsran_ue_dl_cuda_create(uint32_t max_prb, uint32_t mode)
+{
+  if (mode == 0) {
+    mode = uedl_mode_from_env();
+  }
+  if (mode == 0 || max_prb == 0) {
+    return nullptr;
+  }
+  if (ocudu_phy_cuda_init() != NR_LDPC_SUCCESS) {
+    fprintf(stderr, "[ue_dl_cuda] ocudu_phy_cuda_init failed\n");
+    return nullptr;
+  }
+  const char* sync_mode = getenv("SRSRAN_LDPC_CUDA_SYNC");
+  if (sync_mode != nullptr && strcmp(sync_mode, "block") == 0) {
+    cudaSetDeviceFlags(cudaDeviceScheduleBlockingSync);
+  } else {
+    cudaSetDeviceFlags(cudaDeviceScheduleSpin);
+  }
+  srsran_ue_dl_cuda_t* q = new srsran_ue_dl_cuda_t();
+  q->mode     = mode;
+  q->max_prb  = max_prb;
+  q->sync_mode = (sync_mode == nullptr) ? 2 : (strcmp(sync_mode, "block") == 0) ? 1 : (strcmp(sync_mode, "spin") == 0) ? 0 : 2;
+  const char* v = getenv("SRSRAN_LDPC_CUDA_VERBOSE");
+  q->verbose    = (v != nullptr && v[0] != '0');
+  q->max_re     = max_prb * 12 * UEDL_NSYMB;
+  size_t max_N  = 4096; // up to 270 PRB at 15 kHz; replanned on demand
+  if (cudaStreamCreateWithFlags(&q->stream, cudaStreamNonBlocking) != cudaSuccess ||
+      cudaEventCreate(&q->ev0) != cudaSuccess || cudaEventCreate(&q->ev1) != cudaSuccess ||
+      cudaMalloc(&q->fft_in, sizeof(float2) * UEDL_NSYMB * max_N) != cudaSuccess ||
+      cudaMalloc(&q->fft_out, sizeof(float2) * UEDL_NSYMB * max_N) != cudaSuccess ||
+      cudaMallocManaged(&q->grid_bf16, sizeof(uint32_t) * q->max_re) != cudaSuccess ||
+      cudaMallocManaged(&q->phase, sizeof(float2) * UEDL_NSYMB) != cudaSuccess ||
+      cudaMallocManaged(&q->re_idx, sizeof(int) * q->max_re) != cudaSuccess ||
+      cudaMalloc(&q->llrs, sizeof(__half) * (size_t)q->max_re * 8) != cudaSuccess ||
+      cudaMalloc(&q->llr_cb, sizeof(__half) * (size_t)UEDL_MAX_CB * UEDL_MAX_N) != cudaSuccess ||
+      cudaMallocManaged(&q->d_E, sizeof(uint32_t) * UEDL_MAX_CB) != cudaSuccess ||
+      cudaMallocManaged(&q->d_off, sizeof(uint32_t) * UEDL_MAX_CB) != cudaSuccess) {
+    fprintf(stderr, "[ue_dl_cuda] allocation failed\n");
+    delete q;
+    return nullptr;
+  }
+  memset(q->grid_bf16, 0, sizeof(uint32_t) * q->max_re);
+  if (mode & SRSRAN_UE_DL_CUDA_PDSCH) {
+    if (pusch_e2e_create(&q->e2e) != NR_LDPC_SUCCESS) {
+      fprintf(stderr, "[ue_dl_cuda] pusch_e2e_create failed, PDSCH stays on the CPU\n");
+      q->e2e = nullptr;
+      q->mode &= ~SRSRAN_UE_DL_CUDA_PDSCH;
+    }
+  }
+  int dev = -1;
+  cudaGetDevice(&dev);
+  cudaDeviceProp prop{};
+  cudaGetDeviceProperties(&prop, dev);
+  fprintf(stderr,
+          "[ue_dl_cuda] mode=%s%s device=%s max_prb=%u sync=%s\n",
+          (q->mode & SRSRAN_UE_DL_CUDA_FFT) ? "fft " : "",
+          (q->mode & SRSRAN_UE_DL_CUDA_PDSCH) ? "pdsch" : "",
+          prop.name,
+          max_prb,
+          q->sync_mode == 2 ? "yield" : q->sync_mode == 1 ? "block" : "spin");
+  return q;
+}
+
+extern "C" void srsran_ue_dl_cuda_free(srsran_ue_dl_cuda_t* q)
+{
+  if (q == nullptr) {
+    return;
+  }
+  if (q->plan_ok) {
+    cufftDestroy(q->plan);
+  }
+  if (q->e2e) {
+    pusch_e2e_destroy(q->e2e);
+  }
+  if (q->reg_ptr) {
+    cudaHostUnregister((void*)q->reg_ptr);
+  }
+  cudaFree(q->fft_in);
+  cudaFree(q->fft_out);
+  cudaFree(q->grid_bf16);
+  cudaFree(q->phase);
+  cudaFree(q->re_idx);
+  cudaFree(q->llrs);
+  cudaFree(q->llr_cb);
+  cudaFree(q->d_E);
+  cudaFree(q->d_off);
+  cudaEventDestroy(q->ev0);
+  cudaEventDestroy(q->ev1);
+  cudaStreamDestroy(q->stream);
+  delete q;
+}
+
+extern "C" uint32_t srsran_ue_dl_cuda_mode(const srsran_ue_dl_cuda_t* q)
+{
+  return q ? q->mode : 0;
+}
+
+extern "C" void srsran_ue_dl_cuda_set_mode(srsran_ue_dl_cuda_t* q, uint32_t mode)
+{
+  if (q) {
+    q->mode = mode & ((q->e2e ? SRSRAN_UE_DL_CUDA_PDSCH : 0) | SRSRAN_UE_DL_CUDA_FFT);
+  }
+}
