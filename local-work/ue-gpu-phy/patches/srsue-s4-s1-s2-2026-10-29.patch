+/**
+ * Local S2: PDSCH on the GPU (OCUDU fused receiver + rate dematching + LDPC). Returns 1 when the TB was
+ * processed, 0 when the configuration is not eligible or the GPU path failed before touching the result
+ * (the caller then runs the CPU path on the same grid).
+ */
+static int ue_dl_nr_decode_pdsch_cuda(srsran_ue_dl_nr_t*         q,
+                                      const srsran_slot_cfg_t*   slot,
+                                      const srsran_sch_cfg_nr_t* cfg,
+                                      srsran_pdsch_res_nr_t*     res)
+{
+  const srsran_sch_grant_nr_t* grant = &cfg->grant;
+  if (q->cuda == NULL || q->cuda_re_idx == NULL || q->pdsch.sch.cuda == NULL ||
+      !(srsran_ue_dl_cuda_mode((srsran_ue_dl_cuda_t*)q->cuda) & SRSRAN_UE_DL_CUDA_PDSCH)) {
+    return 0;
+  }
+  const srsran_sch_tb_t* tb = &grant->tb[0];
+  if (grant->rnti_type != srsran_rnti_type_c || grant->nof_layers > 1 || !tb->enabled || grant->tb[1].enabled ||
+      grant->mapping != srsran_sch_mapping_type_A || cfg->dmrs.type != srsran_dmrs_sch_type_1 ||
+      cfg->dmrs.reference_point_k_rb != 0 || tb->rv != 0 || q->nof_rx_antennas != 1 || tb->softbuffer.rx == NULL ||
+      grant->nof_dmrs_cdm_groups_without_data == 0 || grant->nof_dmrs_cdm_groups_without_data > 2 ||
+      grant->L == 0 || grant->S + grant->L > SRSRAN_NSYMB_PER_SLOT_NR) {
+    return 0;
+  }
+  // Contiguous PRB allocation
+  uint32_t start = UINT32_MAX, count = 0;
+  for (uint32_t i = 0; i < q->carrier.nof_prb; i++) {
+    if (grant->prb_idx[i]) {
+      if (start == UINT32_MAX) {
+        start = i;
+      } else if (i != start + count) {
+        return 0;
+      }
+      count++;
+    }
+  }
+  if (count == 0 || count != grant->nof_prb) {
+    return 0;
+  }
+  // DMRS symbols and reserved RE pattern
+  uint32_t symbols[SRSRAN_DMRS_SCH_MAX_SYMBOLS] = {};
+  int      nof_symbols                          = srsran_dmrs_sch_get_symbols_idx(&cfg->dmrs, grant, symbols);
+  if (nof_symbols <= 0) {
+    return 0;
+  }
+  uint32_t dmrs_mask = 0;
+  for (int i = 0; i < nof_symbols; i++) {
+    dmrs_mask |= 1U << symbols[i];
+  }
+  srsran_re_pattern_t dmrs_pattern = {};
+  if (srsran_dmrs_sch_rvd_re_pattern(&cfg->dmrs, grant, &dmrs_pattern) < SRSRAN_SUCCESS) {
+    return 0;
+  }
+  // Data RE indices in codeword order (same walk as srsran_pdsch_nr_cp)
+  uint32_t n = 0;
+  for (uint32_t l = grant->S; l < grant->S + grant->L; l++) {
+    bool rvd_mask[SRSRAN_NRE * SRSRAN_MAX_PRB_NR] = {};
+    if (srsran_re_pattern_to_symbol_mask(&dmrs_pattern, l, rvd_mask) < SRSRAN_SUCCESS ||
+        srsran_re_pattern_list_to_symbol_mask(&cfg->rvd_re, l, rvd_mask) < SRSRAN_SUCCESS) {
+      return 0;
+    }
+    for (uint32_t rb = start; rb < start + count; rb++) {
+      for (uint32_t k = 0; k < SRSRAN_NRE; k++) {
+        if (!rvd_mask[rb * SRSRAN_NRE + k]) {
+          q->cuda_re_idx[n++] = (int)((q->carrier.nof_prb * l + rb) * SRSRAN_NRE + k);
+        }
+      }
+    }
+  }
+  uint32_t Qm = srsran_mod_bits_x_symbol(tb->mod);
+  if (n == 0 || n != tb->nof_re || n * Qm != tb->nof_bits) {
+    return 0;
+  }
+  // Sequence identities as in srsran_dmrs_sch_seed() and pdsch_nr_cinit()
+  uint32_t dmrs_n_id = q->carrier.pci;
+  uint32_t n_scid    = grant->n_scid ? 1 : 0;
+  if (!grant->n_scid && cfg->dmrs.scrambling_id0_present) {
+    dmrs_n_id = cfg->dmrs.scrambling_id0;
+  } else if (grant->n_scid && cfg->dmrs.scrambling_id1_present) {
+    dmrs_n_id = cfg->dmrs.scrambling_id1;
+  }
+  uint32_t data_n_id = q->carrier.pci;
+  if (cfg->scrambling_id_present && SRSRAN_RNTI_ISUSER(grant->rnti)) {
+    data_n_id = cfg->scambling_id;
+  }
+  srsran_ue_dl_cuda_pdsch_t p      = {};
+  p.carrier_nof_prb                = q->carrier.nof_prb;
+  p.start_prb                      = start;
+  p.nof_prb                        = count;
+  p.S                              = grant->S;
+  p.L                              = grant->L;
+  p.dmrs_symbol_mask               = dmrs_mask;
+  p.nof_cdm_groups_without_data    = grant->nof_dmrs_cdm_groups_without_data;
+  p.dmrs_scrambling_id             = dmrs_n_id;
+  p.n_scid                         = n_scid;
+  p.slot_idx                       = SRSRAN_SLOT_NR_MOD(q->carrier.scs, slot->idx);
+  p.beta_dmrs                      = isnormal(grant->beta_dmrs) ? grant->beta_dmrs : 1.0f;
+  p.Qm                             = Qm;
+  p.rnti                           = grant->rnti;
+  p.data_n_id                      = (uint16_t)data_n_id;
+  p.nof_data_re                    = n;
+  p.re_indices                     = q->cuda_re_idx;
+#ifdef UEDL_TRACE
+  const int64_t st_gp0__ = st_now_ns();
+#endif
+  const void*              d_llrs = NULL;
+  srsran_ue_dl_cuda_meas_t meas   = {};
+  if (srsran_ue_dl_cuda_pdsch_llrs((srsran_ue_dl_cuda_t*)q->cuda, &p, &d_llrs, &meas) < 0) {
+    return 0;
+  }
+  if (srsran_dlsch_nr_decode_device(&q->pdsch.sch, &cfg->sch_cfg, tb, q->cuda, d_llrs, &res->tb[0]) < SRSRAN_SUCCESS) {
+    return 0;
+  }
+  res->evm[0] = 0.0f;
+  // Channel measurements from the GPU estimator (same fields the CPU estimator fills)
+  q->chest.nof_re             = n;
+  q->chest.rsrp               = meas.rsrp;
+  q->chest.rsrp_dbm           = srsran_convert_power_to_dB(meas.rsrp);
+  q->chest.noise_estimate     = meas.noise;
+  q->chest.noise_estimate_dbm = srsran_convert_power_to_dB(meas.noise);
+  q->chest.snr_db             = meas.sinr_db;
+  q->chest.cfo                = meas.cfo_hz;
+  q->chest.sync_error         = meas.ta_us;
+  q->dmrs_pdsch.csi.rsrp      = meas.rsrp;
+  q->dmrs_pdsch.csi.rsrp_dB   = q->chest.rsrp_dbm;
+  q->dmrs_pdsch.csi.epre      = meas.epre;
+  q->dmrs_pdsch.csi.epre_dB   = srsran_convert_power_to_dB(meas.epre);
+  q->dmrs_pdsch.csi.n0        = meas.noise;
+  q->dmrs_pdsch.csi.n0_dB     = q->chest.noise_estimate_dbm;
+  q->dmrs_pdsch.csi.snr_dB    = meas.sinr_db;
+  q->dmrs_pdsch.csi.cfo_hz    = meas.cfo_hz;
+  q->dmrs_pdsch.csi.delay_us  = meas.ta_us;
+#ifdef UEDL_TRACE
+  srsran_ue_dl_cuda_timing_t t = {};
+  srsran_ue_dl_cuda_get_timing((srsran_ue_dl_cuda_t*)q->cuda, &t);
+  st_ev("uedl", "GPDSCH", slot->idx, ST_US(st_gp0__), n, res->tb[0].crc);
+  st_ev("uedl", "GPT", slot->idx, (long long)t.e2e_launch_us, (long long)(t.rm_launch_us + t.ldpc_launch_us), (long long)t.wait_us);
+  st_ev("uedl", "GPG", slot->idx, (long long)t.gpu_span_us, (long long)t.unpack_us, Qm);
+#endif
+  q->cuda_pdsch_count++;
+  return 1;
+}
+
+void srsran_ue_dl_nr_set_cuda_mode(srsran_ue_dl_nr_t* q, uint32_t mode)
+{
+  if (q != NULL && q->cuda != NULL) {
+    srsran_ue_dl_cuda_set_mode((srsran_ue_dl_cuda_t*)q->cuda, mode);
+  }
+}
+#else
+void srsran_ue_dl_nr_set_cuda_mode(srsran_ue_dl_nr_t* q, uint32_t mode) {}
+#endif // SRSRAN_LDPC_CUDA
+
 int srsran_ue_dl_nr_decode_pdsch(srsran_ue_dl_nr_t*         q,
                                  const srsran_slot_cfg_t*   slot,
                                  const srsran_sch_cfg_nr_t* cfg,
                                  srsran_pdsch_res_nr_t*     res)
 {
+#ifdef SRSRAN_LDPC_CUDA
+  if (ue_dl_nr_decode_pdsch_cuda(q, slot, cfg, res) > 0) {
+    if (SRSRAN_DEBUG_ENABLED && get_srsran_verbose_level() >= SRSRAN_VERBOSE_INFO && !is_handler_registered()) {
+      char str[512];
+      srsran_ue_dl_nr_pdsch_info(q, cfg, res, str, sizeof(str));
+      INFO("PDSCH (gpu): %s", str);
+    }
+    return SRSRAN_SUCCESS;
+  }
+#endif
   if (srsran_dmrs_sch_estimate(&q->dmrs_pdsch, slot, cfg, &cfg->grant, q->sf_symbols[0], &q->chest) < SRSRAN_SUCCESS) {
     return SRSRAN_ERROR;
   }
