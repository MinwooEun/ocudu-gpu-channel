+#ifdef SRSRAN_LDPC_CUDA
+/**
+ * Local S1: rate-dematch every pending code block, decode them in one GPU call, then check CRC and pack like the
+ * per-CB CPU loop does. Returns SRSRAN_SUCCESS when the GPU path handled the TB, SRSRAN_ERROR to fall back.
+ */
+static int sch_nr_decode_cuda_cbs(srsran_sch_nr_t*               q,
+                                  const srsran_sch_nr_tb_info_t* cfg,
+                                  const srsran_sch_tb_t*         tb,
+                                  srsran_ldpc_decoder_t*         decoder,
+                                  int8_t*                        e_bits,
+                                  uint32_t*                      cb_ok,
+                                  uint32_t*                      nof_iter_sum)
+{
+  const int8_t* llr_ptrs[SRSRAN_SCH_NR_MAX_NOF_CB_LDPC];
