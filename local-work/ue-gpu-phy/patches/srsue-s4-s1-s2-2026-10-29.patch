+extern "C" float* srsran_ue_dl_cuda_alloc_grid(srsran_ue_dl_cuda_t* q, uint32_t nof_re_total)
+{
+  float* p = nullptr;
+  if (cudaMallocManaged(&p, sizeof(float2) * (size_t)nof_re_total) != cudaSuccess) {
