diff --git a/lib/include/srsran/phy/fec/ldpc/ldpc_dec_cuda.h b/lib/include/srsran/phy/fec/ldpc/ldpc_dec_cuda.h
new file mode 100644
index 0000000..a66cbaf
--- /dev/null
+++ b/lib/include/srsran/phy/fec/ldpc/ldpc_dec_cuda.h
@@ -0,0 +1,70 @@
+/**
+ * Local S1 (2026-10-27): batch LDPC decoding of one transport block on the GPU through the OCUDU CUDA LDPC
+ * decoder (lib/phy/cuda, libocudu_phy_cuda.a). Selected at run time with SRSRAN_LDPC_DECODER=cuda; compiled in
+ * with -DSRSRAN_LDPC_CUDA=ON. Input/output conventions match the srsRAN CPU decoder: LLRs start at codeword bit
+ * 2*Z (punctured systematic bits excluded), negative LLR = bit 1, message is one byte per bit, liftK bits per CB.
+ */
+#ifndef SRSRAN_LDPC_DEC_CUDA_H
+#define SRSRAN_LDPC_DEC_CUDA_H
+
+#include "srsran/config.h"
+#include <stdbool.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct srsran_ldpc_cuda_s srsran_ldpc_cuda_t;
+
+/// Creates the decoder (one CUDA context, buffers for SRSRAN_SCH_NR_MAX_NOF_CB_LDPC code blocks). NULL on failure.
+SRSRAN_API srsran_ldpc_cuda_t* srsran_ldpc_cuda_create(uint32_t max_nof_iter, float scaling_fctr);
+
+SRSRAN_API void srsran_ldpc_cuda_free(srsran_ldpc_cuda_t* q);
+
+/**
+ * Decodes nof_cb code blocks of the same (bg, ls, F) in one GPU call.
+ * \param bg        1 or 2
+ * \param ls        lifting size Z
+ * \param F         filler bits per code block
+ * \param nof_cb    number of code blocks (<= SRSRAN_SCH_NR_MAX_NOF_CB_LDPC)
+ * \param llrs      per-CB rate-dematched int8 LLRs (codeword bits 2Z..), n_llr valid entries each
+ * \param n_llr     number of valid LLRs per CB (<= liftN - 2Z)
+ * \param crc_type  0 none, 16, 241 (CRC24A), 242 (CRC24B): used only for the decoder's early termination
+ * \param messages  per-CB output, liftK bytes each (one bit per byte)
+ * \param avg_iter  average iterations over the batch (may be NULL)
+ * \return 0 on success, -1 on failure (caller falls back to the CPU decoder)
+ */
+SRSRAN_API int srsran_ldpc_cuda_decode_tb(srsran_ldpc_cuda_t*  q,
+                                          int                  bg,
+                                          uint16_t             ls,
+                                          uint32_t             F,
+                                          uint32_t             nof_cb,
+                                          const int8_t* const* llrs,
+                                          uint32_t             n_llr,
+                                          uint32_t             crc_type,
+                                          uint8_t* const*      messages,
+                                          float*               avg_iter);
+
+/**
+ * Local S2: selects (creating/configuring if needed) the cached decoder handle for (bg, ls, F, crc_type) and
+ * nof_cb code blocks. Returns the OCUDU ldpc_decoder_handle_t, the output word buffer (LDPC_CUDA_MAX_KW words
+ * per CB), the iteration limit and the host sync mode (0 spin, 1 block, 2 yield). The caller runs
+ * ldpc_decoder_decode_batch_half on its own stream.
+ */
+SRSRAN_API int srsran_ldpc_cuda_select(srsran_ldpc_cuda_t* q,
+                                       int                 bg,
+                                       uint16_t            ls,
+                                       uint32_t            F,
+                                       uint32_t            crc_type,
+                                       uint32_t            nof_cb,
+                                       void**              dec_handle,
+                                       uint32_t**          out_words,
+                                       uint32_t*           max_nof_iter,
+                                       int*                sync_mode);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif // SRSRAN_LDPC_DEC_CUDA_H
