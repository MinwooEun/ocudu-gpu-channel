+
+static double now_us()
+{
+  return std::chrono::duration<double, std::micro>(std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+
+static cudaError_t uedl_sync(srsran_ue_dl_cuda_t* q)
+{
+  if (q->sync_mode != 2) {
+    return cudaStreamSynchronize(q->stream);
+  }
+  double      t0 = now_us();
+  cudaError_t err;
+  while ((err = cudaStreamQuery(q->stream)) == cudaErrorNotReady) {
+    if (now_us() - t0 > 40.0) {
+      sched_yield();
+    }
+  }
+  return err;
