+
+#define UEDL_MAX_CB 152          // SRSRAN_SCH_NR_MAX_NOF_CB_LDPC
+#define UEDL_MAX_N (68 * 384)    // BG1 Z=384 codeword incl. punctured bits
+#define UEDL_NSYMB 14
+#define UEDL_LLR_CLAMP 48.0f     // |LLR| bound after accumulation (fp16, decoder clamp is 127)
+#define UEDL_FILLER_LLR 48.0f    // filler bits are known zeros: large positive LLR
+
+#define UEDL_CK(x)                                                                                                   \
+  do {                                                                                                               \
+    cudaError_t e_ = (x);                                                                                            \
+    if (e_ != cudaSuccess) {                                                                                         \
+      fprintf(stderr, "[ue_dl_cuda] %s failed: %s\n", #x, cudaGetErrorString(e_));                                   \
+      return -1;                                                                                                     \
+    }                                                                                                                \
+  } while (0)
+
