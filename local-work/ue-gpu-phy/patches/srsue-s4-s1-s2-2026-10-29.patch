index 0000000..4356ce4
--- /dev/null
+++ b/lib/src/phy/fec/ldpc/ldpc_dec_cuda.cpp
@@ -0,0 +1,313 @@
+/**
+ * Local S1 (2026-10-27): GPU batch LDPC decoder for sch_nr.c, see ldpc_dec_cuda.h.
+ * Built only with SRSRAN_LDPC_CUDA=ON (needs the OCUDU lib/phy/cuda headers and libocudu_phy_cuda.a).
+ */
+#include "srsran/phy/fec/ldpc/ldpc_dec_cuda.h"
+#include "ocudu_phy_cuda.h"
+#include <cuda_fp16.h>
+#include <cuda_runtime.h>
+#include <chrono>
+#include <sched.h>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+#define LDPC_CUDA_MAX_CB 152     // SRSRAN_SCH_NR_MAX_NOF_CB_LDPC
+#define LDPC_CUDA_MAX_N (68 * 384) // BG1, Z=384 codeword incl. punctured bits
+#define LDPC_CUDA_MAX_KW ((22 * 384 + 31) / 32)
+
+#define LDPC_CUDA_MAX_HANDLES 64
+#define LDPC_CUDA_PREALLOC_CB 32
+
+struct ldpc_cuda_handle_s {
+  ldpc_decoder_handle_t dec;
+  int                   bg;
+  uint16_t              ls;
+  uint32_t              F;
+  uint32_t              crc;
+  int                   prealloc_cb;
+  uint64_t              last_use;
+};
+
+struct srsran_ldpc_cuda_s {
+  ldpc_decoder_handle_t dec; // handle selected for the current call
+  ldpc_cuda_handle_s    handles[LDPC_CUDA_MAX_HANDLES];
+  int                   nof_handles;
+  uint64_t              use_counter;
+  cudaStream_t          stream;
+  __half*               llr;    // managed, LDPC_CUDA_MAX_N * LDPC_CUDA_MAX_CB
+  uint32_t*             out;    // managed, LDPC_CUDA_MAX_KW * LDPC_CUDA_MAX_CB
+  uint32_t              max_nof_iter;
+  float                 scaling;
+  bool                  verbose;
+  int                   sync_mode; // 0 spin (cudaStreamSynchronize), 1 block, 2 yield-poll
+};
+
+static cudaError_t ldpc_cuda_sync(srsran_ldpc_cuda_t* q)
+{
+  if (q->sync_mode != 2) {
+    return cudaStreamSynchronize(q->stream);
+  }
+  auto        t0 = std::chrono::steady_clock::now();
+  cudaError_t err;
+  while ((err = cudaStreamQuery(q->stream)) == cudaErrorNotReady) {
+    if (std::chrono::duration<double, std::micro>(std::chrono::steady_clock::now() - t0).count() > 40.0) {
+      sched_yield();
+    }
+  }
+  return err;
+}
+
+static inline unsigned cuda_bitpos(unsigned i)
+{
+  unsigned b = i % 32;
+  return (b / 8) * 8 + (7 - (b % 8));
+}
+
+#define LDPC_CUDA_CK(x)                                                                                              \
+  do {                                                                                                               \
+    cudaError_t e_ = (x);                                                                                            \
+    if (e_ != cudaSuccess) {                                                                                         \
+      fprintf(stderr, "[ldpc_cuda] %s failed: %s\n", #x, cudaGetErrorString(e_));                                    \
+      return -1;                                                                                                     \
+    }                                                                                                                \
+  } while (0)
+
+static int ldpc_cuda_params(srsran_ldpc_cuda_t* q, int bg, uint16_t ls, uint32_t F, uint32_t crc_type, nr_ldpc_config_t* cfg, ldpc_decoder_params_t* dp)
+{
+  const int Kb = (bg == 1) ? 22 : 10, Pc = (bg == 1) ? 46 : 42;
+  *cfg                    = {};
+  cfg->base_graph         = bg;
+  cfg->lifting_size       = ls;
+  cfg->lifting_set_index  = nr_ldpc_get_lifting_set_index(ls);
+  cfg->num_info_bits      = Kb * ls - (int)F;
+  cfg->num_parity_bits    = Pc * ls;
+  cfg->num_filler_bits    = (int)F;
+  cfg->num_codeword_bits  = (Kb + Pc) * ls;
+  cfg->puncture           = true;
+  cfg->max_parity_nodes   = Pc;
+  cfg->redundancy_version = 0;
+  ldpc_decoder_params_init(dp);
+  dp->max_iterations           = (int)q->max_nof_iter;
+  dp->early_termination        = true;
+  dp->auto_scale               = false;
+  dp->min_sum_scale            = q->scaling;
+  dp->min_sum_offset           = 0.10f;
+  dp->llr_clamp                = 127.0f;
+  dp->syndrome_tolerance       = 0;
+  dp->deferred_iteration_stats = true;
+  dp->use_boxplus              = true;
+  dp->confidence_threshold     = 0.15f;
+  dp->crc_early_termination    = (crc_type != 0);
+  dp->crc_type = (crc_type == 16) ? LDPC_CRC_16 : (crc_type == 241) ? LDPC_CRC_24A : (crc_type == 242) ? LDPC_CRC_24B : LDPC_CRC_NONE;
+  return 0;
+}
+
+/* Every (bg, ls, F, crc) combination gets its own configured decoder handle: ldpc_decoder_configure costs
+ * milliseconds (13k reconfigurations in a 20 s live run, decode stalls up to 9.6 ms before this cache). */
+static int ldpc_cuda_configure(srsran_ldpc_cuda_t* q, int bg, uint16_t ls, uint32_t F, uint32_t crc_type, uint32_t nof_cb)
+{
+  q->use_counter++;
+  int slot = -1;
+  for (int i = 0; i < q->nof_handles; i++) {
+    ldpc_cuda_handle_s* h = &q->handles[i];
+    if (h->bg == bg && h->ls == ls && h->F == F && h->crc == crc_type) {
+      slot = i;
+      break;
+    }
+  }
+  if (slot < 0) {
+    if (q->nof_handles < LDPC_CUDA_MAX_HANDLES) {
+      slot = q->nof_handles++;
+      q->handles[slot] = {};
+    } else {
+      // evict the least recently used handle
+      slot = 0;
+      for (int i = 1; i < q->nof_handles; i++) {
+        if (q->handles[i].last_use < q->handles[slot].last_use) {
+          slot = i;
+        }
+      }
+      ldpc_decoder_destroy(q->handles[slot].dec);
+      q->handles[slot] = {};
+    }
+    ldpc_cuda_handle_s* h = &q->handles[slot];
+    auto t_create0 = std::chrono::steady_clock::now();
+    if (ldpc_decoder_create(&h->dec) != NR_LDPC_SUCCESS) {
+      fprintf(stderr, "[ldpc_cuda] decoder create failed\n");
+      q->nof_handles--;
+      return -1;
+    }
+    nr_ldpc_config_t      cfg;
+    ldpc_decoder_params_t dp;
+    ldpc_cuda_params(q, bg, ls, F, crc_type, &cfg, &dp);
+    if (ldpc_decoder_configure(h->dec, &cfg, &dp) != NR_LDPC_SUCCESS) {
+      fprintf(stderr, "[ldpc_cuda] configure failed bg=%d ls=%d F=%u\n", bg, ls, F);
+      ldpc_decoder_destroy(h->dec);
+      q->handles[slot] = {};
+      q->nof_handles--;
+      return -1;
+    }
+    h->bg = bg; h->ls = ls; h->F = F; h->crc = crc_type; h->prealloc_cb = 0;
+    if (q->verbose) {
+      double us = std::chrono::duration<double, std::micro>(std::chrono::steady_clock::now() - t_create0).count();
+      fprintf(stderr, "[ldpc_cuda] configured handle %d: bg=%d ls=%d F=%u crc=%u (handles=%d) create+configure=%.0f us\n", slot, bg, ls, F, crc_type, q->nof_handles, us);
+    }
+  }
+  ldpc_cuda_handle_s* h = &q->handles[slot];
+  int want = (nof_cb > (uint32_t)h->prealloc_cb) ? ((nof_cb <= 8) ? 8 : (nof_cb <= 32) ? 32 : LDPC_CUDA_MAX_CB) : h->prealloc_cb;
+  if (h->prealloc_cb < want) {
+    auto t_pre0 = std::chrono::steady_clock::now();
+    if (ldpc_decoder_preallocate_workspace(h->dec, want) != NR_LDPC_SUCCESS) {
+      fprintf(stderr, "[ldpc_cuda] preallocate failed\n");
+      return -1;
+    }
+    h->prealloc_cb = want;
+    if (q->verbose) {
+      double us = std::chrono::duration<double, std::micro>(std::chrono::steady_clock::now() - t_pre0).count();
+      fprintf(stderr, "[ldpc_cuda] preallocate(%d) for handle bg=%d ls=%d F=%u: %.0f us\n", want, bg, ls, F, us);
+    }
+  }
+  h->last_use = q->use_counter;
+  q->dec      = h->dec;
+  return 0;
+}
+
+extern "C" srsran_ldpc_cuda_t* srsran_ldpc_cuda_create(uint32_t max_nof_iter, float scaling_fctr)
+{
+  if (ocudu_phy_cuda_init() != NR_LDPC_SUCCESS) {
+    fprintf(stderr, "[ldpc_cuda] ocudu_phy_cuda_init failed\n");
+    return nullptr;
+  }
+  // Blocking sync: with cudaDeviceScheduleAuto the host spins in cudaStreamSynchronize and burns the UE core
+  // for the whole GPU decode; a single-core srsUE at 50 MHz has no core to spare.
+  // SRSRAN_LDPC_CUDA_SYNC=spin|block|yield (default yield: spin ~40 us, then poll with sched_yield; keeps the
+  // wake-up latency of a spin while letting the other UE threads use the core during the GPU decode).
+  const char* sync_mode = getenv("SRSRAN_LDPC_CUDA_SYNC");
+  if (sync_mode != nullptr && strcmp(sync_mode, "block") == 0) {
+    cudaSetDeviceFlags(cudaDeviceScheduleBlockingSync);
+  } else {
+    cudaSetDeviceFlags(cudaDeviceScheduleSpin);
+  }
+  srsran_ldpc_cuda_t* q = new srsran_ldpc_cuda_t();
+  q->max_nof_iter       = max_nof_iter ? max_nof_iter : 10;
+  q->scaling            = (scaling_fctr > 0.f) ? scaling_fctr : 0.8f;
+  const char* v         = getenv("SRSRAN_LDPC_CUDA_VERBOSE");
+  q->verbose            = (v != nullptr && v[0] != '0');
+  q->sync_mode          = (sync_mode == nullptr) ? 2 : (strcmp(sync_mode, "block") == 0) ? 1 : (strcmp(sync_mode, "spin") == 0) ? 0 : 2;
+  q->dec         = nullptr;
+  q->nof_handles = 0;
+  q->use_counter = 0;
+  if (cudaStreamCreateWithFlags(&q->stream, cudaStreamNonBlocking) != cudaSuccess ||
+      cudaMallocManaged(&q->llr, sizeof(__half) * (size_t)LDPC_CUDA_MAX_N * LDPC_CUDA_MAX_CB) != cudaSuccess ||
+      cudaMallocManaged(&q->out, sizeof(uint32_t) * (size_t)LDPC_CUDA_MAX_KW * LDPC_CUDA_MAX_CB) != cudaSuccess) {
+    fprintf(stderr, "[ldpc_cuda] buffer allocation failed\n");
+    delete q;
+    return nullptr;
+  }
+  // Warm-up (kernel load) with a BG1/Z384 configuration so the first live slot does not pay for it.
+  if (ldpc_cuda_configure(q, 1, 384, 0, 242, 1) == 0) {
+    memset(q->llr, 0, sizeof(__half) * (size_t)LDPC_CUDA_MAX_N);
+    ldpc_decoder_decode_batch_half(q->dec, q->llr, q->out, 1, q->stream);
+    cudaStreamSynchronize(q->stream);
+  }
+  int dev = -1; cudaGetDevice(&dev);
+  cudaDeviceProp prop{}; cudaGetDeviceProperties(&prop, dev);
+  fprintf(stderr, "[ldpc_cuda] backend=cuda device=%s sm_%d%d max_cb=%d handle_cache=%d max_iter=%u scale=%.2f sync=%s\n", prop.name, prop.major, prop.minor, LDPC_CUDA_MAX_CB, LDPC_CUDA_MAX_HANDLES, q->max_nof_iter, q->scaling, q->sync_mode == 2 ? "yield" : q->sync_mode == 1 ? "block" : "spin");
+  return q;
+}
+
+extern "C" void srsran_ldpc_cuda_free(srsran_ldpc_cuda_t* q)
+{
+  if (q == nullptr) {
+    return;
+  }
+  if (q->llr) cudaFree(q->llr);
+  if (q->out) cudaFree(q->out);
+  for (int i = 0; i < q->nof_handles; i++) {
+    if (q->handles[i].dec) ldpc_decoder_destroy(q->handles[i].dec);
+  }
+  if (q->stream) cudaStreamDestroy(q->stream);
+  delete q;
+}
+
+extern "C" int srsran_ldpc_cuda_select(srsran_ldpc_cuda_t* q,
+                                       int                 bg,
+                                       uint16_t            ls,
+                                       uint32_t            F,
+                                       uint32_t            crc_type,
+                                       uint32_t            nof_cb,
+                                       void**              dec_handle,
+                                       uint32_t**          out_words,
+                                       uint32_t*           max_nof_iter,
+                                       int*                sync_mode)
+{
+  if (q == nullptr || nof_cb == 0 || nof_cb > LDPC_CUDA_MAX_CB || dec_handle == nullptr || out_words == nullptr) {
+    return -1;
+  }
+  if (ldpc_cuda_configure(q, bg, ls, F, crc_type, nof_cb) < 0) {
+    return -1;
+  }
+  *dec_handle = (void*)q->dec;
+  *out_words  = q->out;
+  if (max_nof_iter) {
+    *max_nof_iter = q->max_nof_iter;
+  }
+  if (sync_mode) {
+    *sync_mode = q->sync_mode;
+  }
+  return 0;
+}
+
+extern "C" int srsran_ldpc_cuda_decode_tb(srsran_ldpc_cuda_t*  q,
+                                          int                  bg,
+                                          uint16_t             ls,
+                                          uint32_t             F,
+                                          uint32_t             nof_cb,
+                                          const int8_t* const* llrs,
+                                          uint32_t             n_llr,
+                                          uint32_t             crc_type,
+                                          uint8_t* const*      messages,
+                                          float*               avg_iter)
+{
+  if (q == nullptr || nof_cb == 0 || nof_cb > LDPC_CUDA_MAX_CB) {
+    return -1;
+  }
+  if (ldpc_cuda_configure(q, bg, ls, F, crc_type, nof_cb) < 0) {
+    return -1;
+  }
+  const uint32_t Kb = (bg == 1) ? 22 : 10, Pc = (bg == 1) ? 46 : 42;
+  const uint32_t N_full = (Kb + Pc) * ls, liftK = Kb * ls, K_words = (liftK + 31) / 32, skip = 2 * ls;
+  if (n_llr > N_full - skip) {
+    n_llr = N_full - skip;
+  }
+  // Fill fp16 LLRs: punctured 2Z zeros, then the dematched LLRs, then zeros.
+  for (uint32_t c = 0; c < nof_cb; c++) {
+    __half*       dst = q->llr + (size_t)c * N_full;
+    const int8_t* src = llrs[c];
+    for (uint32_t i = 0; i < skip; i++) dst[i] = __float2half(0.f);
+    for (uint32_t i = 0; i < n_llr; i++) dst[skip + i] = __float2half((float)src[i]);
+    for (uint32_t i = skip + n_llr; i < N_full; i++) dst[i] = __float2half(0.f);
+  }
+  if (ldpc_decoder_decode_batch_half(q->dec, q->llr, q->out, (int)nof_cb, q->stream) != NR_LDPC_SUCCESS) {
+    fprintf(stderr, "[ldpc_cuda] decode_batch_half failed (nof_cb=%u)\n", nof_cb);
+    return -1;
+  }
+  if (avg_iter != nullptr) {
+    ldpc_decoder_flush_iteration_stats(q->dec, q->stream);
+  }
+  LDPC_CUDA_CK(ldpc_cuda_sync(q));
+  for (uint32_t c = 0; c < nof_cb; c++) {
+    const uint32_t* w   = q->out + (size_t)c * K_words;
+    uint8_t*        msg = messages[c];
+    for (uint32_t i = 0; i < liftK; i++) {
+      msg[i] = (uint8_t)((w[i / 32] >> cuda_bitpos(i)) & 1u);
+    }
+  }
+  if (avg_iter != nullptr) {
+    bool  ready = false;
+    float it    = ldpc_decoder_get_avg_iterations_async(q->dec, &ready);
+    *avg_iter   = ready ? it : (float)q->max_nof_iter;
+  }
+  return 0;
+}
