diff --git a/lib/include/srsran/phy/ue/ue_dl_cuda.h b/lib/include/srsran/phy/ue/ue_dl_cuda.h
new file mode 100644
index 0000000..91c5e6c
--- /dev/null
+++ b/lib/include/srsran/phy/ue/ue_dl_cuda.h
@@ -0,0 +1,160 @@
+/**
+ * Local S2 (2026-10-29): GPU front end for the srsUE NR downlink receive chain.
+ *
+ *  - OFDM demodulation of one 1 ms subframe (14 symbols at 15 kHz): CP removal, DFT window offset, cuFFT,
+ *    FFT shift and per-symbol phase compensation exactly as srsran_ofdm_rx_sf(), written to the float resource
+ *    grid the CPU keeps using (PDCCH, CSI) and in parallel to a complex-bf16 copy for the GPU PDSCH path.
+ *  - PDSCH reception through the OCUDU fused PUSCH receiver (DMRS channel estimation, MMSE equalisation, soft
+ *    demodulation, descrambling -> fp16 LLRs), a rate-dematching kernel that mirrors srsran_ldpc_rm_rx_c(), and
+ *    the OCUDU batch LDPC decoder (handle cache of ldpc_dec_cuda.cpp).
+ *
+ * Selected at run time with SRSRAN_UE_DL_CUDA=fft|pdsch|all (pdsch needs SRSRAN_LDPC_DECODER=cuda); compiled
+ * in with -DSRSRAN_LDPC_CUDA=ON. Every entry point returns a negative value when the GPU path cannot be used,
+ * in which case the caller runs the CPU path on the same buffers.
+ *
+ * This header is shared between C (ue_dl_nr.c) and CUDA C++ (ue_dl_cuda.cu): complex samples are passed as
+ * interleaved float pairs and no srsRAN type is used.
+ */
+#ifndef SRSRAN_UE_DL_CUDA_H
+#define SRSRAN_UE_DL_CUDA_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#ifndef SRSRAN_API
+#define SRSRAN_API
+#endif
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define SRSRAN_UE_DL_CUDA_FFT 1U
+#define SRSRAN_UE_DL_CUDA_PDSCH 2U
+
+typedef struct srsran_ue_dl_cuda_s srsran_ue_dl_cuda_t;
+
+/// OFDM demodulation parameters mirrored from the srsran_ofdm_t object of the CPU path.
+typedef struct {
+  uint32_t symbol_sz;       ///< DFT size N
+  uint32_t nof_re;          ///< Subcarriers kept per symbol (nof_prb * 12)
+  uint32_t cp1;             ///< CP length of the first symbol of each 7-symbol slot
+  uint32_t cp2;             ///< CP length of the other symbols
+  uint32_t slot_sz;         ///< Samples per 7-symbol slot (N * 15 / 2)
+  uint32_t window_offset_n; ///< DFT window advance into the CP (samples)
+  uint32_t dc;              ///< 1 when the DC subcarrier is skipped (keep_dc = false)
+  uint32_t normalize;       ///< 1 when the output is divided by sqrt(N)
+  float    phase[2 * 14];   ///< Per-symbol phase compensation (re, im), the receiver multiplies by its conjugate
+} srsran_ue_dl_cuda_ofdm_t;
+
+/// PDSCH parameters needed by the GPU receiver (all derived from the srsRAN grant/config by ue_dl_nr.c).
+typedef struct {
+  uint32_t   carrier_nof_prb;   ///< Resource grid width in PRB
+  uint32_t   start_prb;         ///< First allocated PRB (contiguous allocation)
+  uint32_t   nof_prb;           ///< Number of allocated PRB
+  uint32_t   S;                 ///< First OFDM symbol
+  uint32_t   L;                 ///< Number of OFDM symbols
+  uint32_t   dmrs_symbol_mask;  ///< Bit l set if symbol l carries DMRS
+  uint32_t   nof_cdm_groups_without_data;
+  uint32_t   dmrs_scrambling_id; ///< N_ID used for the DMRS sequence
+  uint32_t   n_scid;
+  uint32_t   slot_idx;          ///< Slot index within the frame
+  float      beta_dmrs;         ///< Linear DMRS amplitude ratio (0 = 1)
+  uint32_t   Qm;                ///< Modulation order (2, 4, 6, 8)
+  uint16_t   rnti;
+  uint16_t   data_n_id;         ///< N_ID used for data scrambling
+  uint32_t   nof_data_re;       ///< Number of entries in re_indices (= grant nof_re)
+  const int* re_indices;        ///< Host array of grid indices (l * carrier_nof_prb * 12 + k) in codeword order
+} srsran_ue_dl_cuda_pdsch_t;
+
+/// Channel measurements the GPU receiver reports back (0 when not available).
+typedef struct {
+  float rsrp;
+  float epre;
+  float noise;
+  float sinr_db;
+  float cfo_hz;
+  float ta_us;
+} srsran_ue_dl_cuda_meas_t;
+
+/**
+ * Creates the GPU context. mode is a bit mask of SRSRAN_UE_DL_CUDA_FFT / _PDSCH; when 0 the environment variable
+ * SRSRAN_UE_DL_CUDA is read (fft, pdsch, all, comma separated). Returns NULL when nothing is enabled.
+ */
+SRSRAN_API srsran_ue_dl_cuda_t* srsran_ue_dl_cuda_create(uint32_t max_prb, uint32_t mode);
+SRSRAN_API void                 srsran_ue_dl_cuda_free(srsran_ue_dl_cuda_t* q);
+SRSRAN_API uint32_t             srsran_ue_dl_cuda_mode(const srsran_ue_dl_cuda_t* q);
+SRSRAN_API void                 srsran_ue_dl_cuda_set_mode(srsran_ue_dl_cuda_t* q, uint32_t mode);
+
+/// Allocates a resource grid (nof_re_total complex floats) in managed memory readable by CPU and GPU.
+SRSRAN_API float* srsran_ue_dl_cuda_alloc_grid(srsran_ue_dl_cuda_t* q, uint32_t nof_re_total);
+SRSRAN_API void   srsran_ue_dl_cuda_free_grid(srsran_ue_dl_cuda_t* q, float* grid);
+
+/// (Re)plans the FFT for a carrier. symbol_sz is the DFT size, nof_prb the grid width.
+SRSRAN_API int srsran_ue_dl_cuda_set_carrier(srsran_ue_dl_cuda_t* q, uint32_t nof_prb, uint32_t symbol_sz);
+
+/**
+ * OFDM demodulation of one subframe. in: time-domain samples (host memory, 15 * N complex floats); grid: output,
+ * a grid from srsran_ue_dl_cuda_alloc_grid. Blocks until the grid is complete. Returns 0 on success.
+ */
+SRSRAN_API int srsran_ue_dl_cuda_fft(srsran_ue_dl_cuda_t*            q,
+                                     const float*                    in,
+                                     const srsran_ue_dl_cuda_ofdm_t* ofdm,
+                                     float*                          grid);
+
+/// Converts a float grid (14 x nof_prb*12 complex) into the internal bf16 grid (CPU FFT + GPU PDSCH mix, tests).
+SRSRAN_API int srsran_ue_dl_cuda_grid_to_bf16(srsran_ue_dl_cuda_t* q, const float* grid, uint32_t nof_prb);
+
+/**
+ * Runs channel estimation, equalisation, soft demodulation and descrambling for one PDSCH on the bf16 grid produced
+ * by the last srsran_ue_dl_cuda_fft()/grid_to_bf16() call. On success *d_llrs points at nof_data_re*Qm fp16 LLRs in
+ * device memory (valid until the next call). Asynchronous: the LLRs are consumed by srsran_ue_dl_cuda_decode_cbs()
+ * on the same stream, which also fills meas (may be NULL).
+ */
+SRSRAN_API int srsran_ue_dl_cuda_pdsch_llrs(srsran_ue_dl_cuda_t*             q,
+                                            const srsran_ue_dl_cuda_pdsch_t* cfg,
+                                            const void**                     d_llrs,
+                                            srsran_ue_dl_cuda_meas_t*        meas);
+
+/**
+ * Rate dematching (bit de-interleaving, circular-buffer selection with filler bits, LLR accumulation on repetition)
+ * and LDPC decoding of nof_cb code blocks of one transport block directly from the device LLRs.
+ * \param ldpc        the srsran_ldpc_cuda_t of the SCH object (handle cache, sync mode)
+ * \param E, off      per-CB rate-matched length and offset in the LLR stream
+ * \param k0, Ncb     circular buffer start and size (codeword bits excluding the 2Z punctured ones)
+ * \param crc_type    0, 16, 241 (CRC24A) or 242 (CRC24B), for the decoder's early termination
+ * \param messages    per-CB output, Kb*Z bytes each (one bit per byte)
+ * Blocks until the decode is complete. Returns 0 on success.
+ */
+SRSRAN_API int srsran_ue_dl_cuda_decode_cbs(srsran_ue_dl_cuda_t* q,
+                                            void*                ldpc,
+                                            int                  bg,
+                                            uint16_t             ls,
+                                            uint32_t             F,
+                                            uint32_t             nof_cb,
+                                            const void*          d_llrs,
+                                            const uint32_t*      E,
+                                            const uint32_t*      off,
+                                            uint32_t             Qm,
+                                            uint32_t             k0,
+                                            uint32_t             Ncb,
+                                            uint32_t             crc_type,
+                                            uint8_t* const*      messages,
+                                            float*               avg_iter);
+
+/// Timing of the last PDSCH call in microseconds (host launch, GPU span from events, wait), for the slot trace.
+typedef struct {
+  float e2e_launch_us;
+  float rm_launch_us;
+  float ldpc_launch_us;
+  float gpu_span_us;
+  float wait_us;
+  float unpack_us;
+} srsran_ue_dl_cuda_timing_t;
+SRSRAN_API void srsran_ue_dl_cuda_get_timing(const srsran_ue_dl_cuda_t* q, srsran_ue_dl_cuda_timing_t* t);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif // SRSRAN_UE_DL_CUDA_H
