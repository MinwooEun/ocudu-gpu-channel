+// ------------------------------------------------------------------------------------------------------------------
+// PDSCH
+// ------------------------------------------------------------------------------------------------------------------
+
+static bool e2e_needs_configure(const pusch_e2e_config_t& a, const pusch_e2e_config_t& b)
+{
+  return a.nof_prb != b.nof_prb || a.nof_symbols != b.nof_symbols || a.grid_nof_subcarriers != b.grid_nof_subcarriers ||
+         a.dmrs_type != b.dmrs_type || a.nof_cdm_groups_without_data != b.nof_cdm_groups_without_data ||
+         a.scrambling_id != b.scrambling_id || a.n_scid != b.n_scid || a.dmrs_scaling != b.dmrs_scaling ||
+         a.start_symbol != b.start_symbol;
+}
+
+extern "C" int srsran_ue_dl_cuda_pdsch_llrs(srsran_ue_dl_cuda_t*             q,
+                                            const srsran_ue_dl_cuda_pdsch_t* c,
+                                            const void**                     d_llrs,
+                                            srsran_ue_dl_cuda_meas_t*        meas)
+{
+  if (q == nullptr || !(q->mode & SRSRAN_UE_DL_CUDA_PDSCH) || q->e2e == nullptr || c == nullptr || d_llrs == nullptr) {
+    return -1;
+  }
+  if (c->nof_data_re == 0 || c->nof_data_re > q->max_re || c->carrier_nof_prb > q->max_prb || c->L == 0 ||
+      c->S + c->L > UEDL_NSYMB || c->start_prb + c->nof_prb > c->carrier_nof_prb || c->nof_cdm_groups_without_data == 0 ||
+      c->nof_cdm_groups_without_data > 2 || (c->Qm != 2 && c->Qm != 4 && c->Qm != 6 && c->Qm != 8)) {
+    return -1;
+  }
+  double t0 = now_us();
+  pusch_e2e_config_t cfg          = {};
+  cfg.nof_prb                     = (int)c->carrier_nof_prb; // configure for the whole carrier: pilots/scrambling cover every allocation
+  cfg.nof_symbols                 = (int)c->L;
+  cfg.nof_rx_ports                = 1;
+  cfg.nof_tx_layers               = 1;
+  cfg.grid_nof_subcarriers        = (int)(c->carrier_nof_prb * 12);
+  cfg.grid_nof_symbols            = UEDL_NSYMB;
+  cfg.dmrs_type                   = DMRS_TYPE_1;
+  cfg.dmrs_symbol_mask            = (int)c->dmrs_symbol_mask;
+  cfg.nof_cdm_groups_without_data = (int)c->nof_cdm_groups_without_data;
+  cfg.scrambling_id               = c->dmrs_scrambling_id;
+  cfg.n_scid                      = (int)c->n_scid;
+  cfg.slot_idx                    = (int)c->slot_idx;
+  cfg.dmrs_scaling                = (c->beta_dmrs > 0.0f) ? c->beta_dmrs : 1.0f;
+  cfg.mod_order                   = (int)c->Qm;
+  cfg.rnti                        = c->rnti;
+  cfg.n_id                        = c->data_n_id;
+  cfg.start_prb                   = 0;
+  cfg.start_symbol                = (int)c->S;
+  cfg.tx_scaling                  = 1.0f;
+  cfg.equalizer_algorithm         = EQUALIZER_MMSE;
+  cfg.scs_khz                     = 15;
+  cfg.use_low_papr_dmrs           = 0;
+  cfg.n_rs_id                     = 0;
+  cfg.compensate_cfo              = 1;
+  cfg.noise_mode                  = 1;
+  cfg.time_interp_mode            = 0;
+  cfg.enable_evm_metric           = 0;
+
+  if (!q->e2e_ok || e2e_needs_configure(cfg, q->e2e_cfg)) {
+    double tc0 = now_us();
+    if (pusch_e2e_configure(q->e2e, &cfg) != NR_LDPC_SUCCESS) {
+      fprintf(stderr, "[ue_dl_cuda] pusch_e2e_configure failed (prb=%u S=%u L=%u mask=0x%x cdm=%u)\n", c->carrier_nof_prb, c->S, c->L, c->dmrs_symbol_mask, c->nof_cdm_groups_without_data);
+      q->e2e_ok = false;
+      return -1;
+    }
+    q->e2e_cfg = cfg;
+    q->e2e_ok  = true;
+    if (q->verbose) {
+      fprintf(stderr, "[ue_dl_cuda] pusch_e2e configured: carrier=%u PRB S=%u L=%u cdm=%u scr_id=%u n_scid=%u beta=%.3f (%.0f us)\n", c->carrier_nof_prb, c->S, c->L, c->nof_cdm_groups_without_data, c->dmrs_scrambling_id, c->n_scid, cfg.dmrs_scaling, now_us() - tc0);
+    }
+  }
+  if (q->e2e_cfg.rnti != c->rnti || q->e2e_cfg.n_id != c->data_n_id || q->e2e_cfg.mod_order != (int)c->Qm) {
+    if (pusch_e2e_update_data_params(q->e2e, c->rnti, c->data_n_id, (int)c->Qm) != NR_LDPC_SUCCESS) {
+      return -1;
+    }
+    q->e2e_cfg.rnti      = c->rnti;
+    q->e2e_cfg.n_id      = c->data_n_id;
+    q->e2e_cfg.mod_order = (int)c->Qm;
+  }
+  if (pusch_e2e_update_slot_config(q->e2e, (int)c->nof_prb, (int)c->start_prb, (int)c->slot_idx, (int)c->dmrs_symbol_mask) != NR_LDPC_SUCCESS) {
+    return -1;
+  }
+  memcpy(q->re_idx, c->re_indices, sizeof(int) * c->nof_data_re);
+  cudaEventRecord(q->ev0, q->stream);
+  nr_ldpc_status_t st = pusch_e2e_process_full_gpu_optimized(q->e2e, q->grid_bf16, q->llrs, q->re_idx, (int)c->nof_data_re, q->stream);
+  if (st != NR_LDPC_SUCCESS) {
+    fprintf(stderr, "[ue_dl_cuda] pusch_e2e_process failed: %s\n", nr_ldpc_get_error_string(st));
+    return -1;
+  }
+  q->pending_meas  = meas;
+  q->meas_launched = false;
+  if (meas != nullptr) {
+    pusch_e2e_sinr_async_launch(q->e2e, q->stream);
+    q->meas_launched = true;
+  }
+  *d_llrs               = q->llrs;
+  q->timing.e2e_launch_us = (float)(now_us() - t0);
+  return 0;
+}
+
+static inline unsigned cuda_bitpos(unsigned i)
+{
+  unsigned b = i % 32;
+  return (b / 8) * 8 + (7 - (b % 8));
+}
+
+extern "C" int srsran_ue_dl_cuda_decode_cbs(srsran_ue_dl_cuda_t* q,
+                                            void*                ldpc,
+                                            int                  bg,
+                                            uint16_t             ls,
+                                            uint32_t             F,
+                                            uint32_t             nof_cb,
+                                            const void*          d_llrs,
+                                            const uint32_t*      E,
+                                            const uint32_t*      off,
+                                            uint32_t             Qm,
+                                            uint32_t             k0,
+                                            uint32_t             Ncb,
+                                            uint32_t             crc_type,
+                                            uint8_t* const*      messages,
+                                            float*               avg_iter)
+{
+  if (q == nullptr || ldpc == nullptr || nof_cb == 0 || nof_cb > UEDL_MAX_CB || d_llrs == nullptr || Qm == 0) {
+    return -1;
+  }
+  void*     dec      = nullptr;
+  uint32_t* out      = nullptr;
+  uint32_t  max_iter = 10;
+  int       sync_mode = 0;
+  double    t0 = now_us();
+  if (srsran_ldpc_cuda_select((srsran_ldpc_cuda_t*)ldpc, bg, ls, F, crc_type, nof_cb, &dec, &out, &max_iter, &sync_mode) < 0) {
+    return -1;
+  }
+  const uint32_t Kb = (bg == 1) ? 22 : 10, Pc = (bg == 1) ? 46 : 42;
+  const uint32_t N_full = (Kb + Pc) * ls, liftK = Kb * ls, K_words = (liftK + 31) / 32;
+  const int      end = (int)(liftK - 2 * ls), ini = end - (int)F;
+  if (Ncb > N_full - 2 * ls || ini < 0 || k0 >= Ncb) {
+    return -1;
+  }
+  for (uint32_t c = 0; c < nof_cb; c++) {
+    q->d_E[c]   = E[c];
+    q->d_off[c] = off[c];
+  }
+  int n = (int)(nof_cb * N_full);
+  k_dematch<<<(n + 255) / 256, 256, 0, q->stream>>>((const __half*)d_llrs, q->d_E, q->d_off, q->llr_cb, (int)nof_cb, (int)N_full, (int)ls, (int)Ncb, (int)k0, ini, end, (int)Qm);
+  q->timing.rm_launch_us = (float)(now_us() - t0);
+  double t1 = now_us();
+  if (ldpc_decoder_decode_batch_half((ldpc_decoder_handle_t)dec, q->llr_cb, out, (int)nof_cb, q->stream) != NR_LDPC_SUCCESS) {
+    fprintf(stderr, "[ue_dl_cuda] decode_batch_half failed (nof_cb=%u)\n", nof_cb);
+    return -1;
+  }
+  if (avg_iter != nullptr) {
+    ldpc_decoder_flush_iteration_stats((ldpc_decoder_handle_t)dec, q->stream);
+  }
+  cudaEventRecord(q->ev1, q->stream);
+  q->timing.ldpc_launch_us = (float)(now_us() - t1);
+  double t2 = now_us();
+  UEDL_CK(uedl_sync(q));
+  q->timing.wait_us = (float)(now_us() - t2);
+  float ms = 0.0f;
+  if (cudaEventElapsedTime(&ms, q->ev0, q->ev1) == cudaSuccess) {
+    q->timing.gpu_span_us = ms * 1000.0f;
+  } else {
+    cudaGetLastError();
+    q->timing.gpu_span_us = 0.0f;
+  }
+  double t3 = now_us();
+  for (uint32_t c = 0; c < nof_cb; c++) {
+    const uint32_t* w   = out + (size_t)c * K_words;
+    uint8_t*        msg = messages[c];
+    for (uint32_t i = 0; i < liftK; i++) {
+      msg[i] = (uint8_t)((w[i / 32] >> cuda_bitpos(i)) & 1u);
+    }
+  }
+  if (avg_iter != nullptr) {
+    bool  ready = false;
+    float it    = ldpc_decoder_get_avg_iterations_async((ldpc_decoder_handle_t)dec, &ready);
+    *avg_iter   = ready ? it : (float)max_iter;
+  }
+  if (q->pending_meas != nullptr) {
+    srsran_ue_dl_cuda_meas_t* m = q->pending_meas;
+    *m                          = {};
+    if (q->meas_launched && q->e2e != nullptr) {
+      m->sinr_db = pusch_e2e_sinr_get_result(q->e2e);
+      m->epre    = pusch_e2e_epre_get_result(q->e2e);
+      m->rsrp    = pusch_e2e_rsrp_get_result(q->e2e);
+      m->cfo_hz  = pusch_e2e_cfo_get_result(q->e2e);
+      m->ta_us   = pusch_e2e_ta_get_result(q->e2e);
+      m->noise   = (m->epre > m->rsrp) ? (m->epre - m->rsrp) : 0.0f;
+    }
+    q->pending_meas = nullptr;
+  }
+  q->timing.unpack_us = (float)(now_us() - t3);
+  return 0;
+}
+
+extern "C" void srsran_ue_dl_cuda_get_timing(const srsran_ue_dl_cuda_t* q, srsran_ue_dl_cuda_timing_t* t)
+{
+  if (q && t) {
+    *t = q->timing;
+  }
+}
