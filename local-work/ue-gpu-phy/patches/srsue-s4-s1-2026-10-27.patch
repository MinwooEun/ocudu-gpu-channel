   return SRSRAN_SUCCESS;
 }
 
+#ifdef SRSRAN_LDPC_CUDA
+/**
+ * Local S1: rate-dematch every pending code block, decode them in one GPU call, then check CRC and pack like the
+ * per-CB CPU loop does. Returns SRSRAN_SUCCESS when the GPU path handled the TB, SRSRAN_ERROR to fall back.
+ */
+static int sch_nr_decode_cuda_cbs(srsran_sch_nr_t*               q,
+                                  const srsran_sch_nr_tb_info_t* cfg,
+                                  const srsran_sch_tb_t*         tb,
+                                  srsran_ldpc_decoder_t*         decoder,
+                                  int8_t*                        e_bits,
+                                  uint32_t*                      cb_ok,
+                                  uint32_t*                      nof_iter_sum)
+{
+  const int8_t* llr_ptrs[SRSRAN_SCH_NR_MAX_NOF_CB_LDPC];
+  uint8_t*      msg_ptrs[SRSRAN_SCH_NR_MAX_NOF_CB_LDPC];
+  uint32_t      cb_idx[SRSRAN_SCH_NR_MAX_NOF_CB_LDPC];
+  uint32_t      n          = 0;
+  uint32_t      n_llr      = 0;
+  uint32_t      ok_before  = 0;
+  int8_t*       input_ptr  = e_bits;
+  uint32_t      j          = 0;
+  uint32_t      cb_len     = cfg->Kp - cfg->L_cb;
+
+  for (uint32_t r = 0; r < cfg->C; r++) {
+    bool    decoded   = tb->softbuffer.rx->cb_crc[r];
+    int8_t* rm_buffer = (int8_t*)tb->softbuffer.tx->buffer_b[r];
+    if (!rm_buffer) {
+      return SRSRAN_ERROR;
+    }
+    if (!cfg->mask[r]) {
+      if (decoded) {
+        ok_before++;
+      }
+      continue;
+    }
+    uint32_t E = sch_nr_get_E(cfg, j);
+    j++;
+    if (decoded) {
+      ok_before++;
+      continue; // same as the CPU loop: input_ptr is not advanced for already decoded CBs
+    }
+    int ret = srsran_ldpc_rm_rx_c(&q->rx_rm, input_ptr, rm_buffer, E, cfg->F, cfg->bg, cfg->Z, tb->rv, tb->mod, cfg->Nref);
+    if (ret < SRSRAN_SUCCESS) {
+      return SRSRAN_ERROR;
+    }
+    n_llr       = (uint32_t)ret;
+    llr_ptrs[n] = rm_buffer;
+    msg_ptrs[n] = q->temp_cb_batch + (size_t)n * SRSRAN_LDPC_MAX_LEN_CB;
+    cb_idx[n]   = r;
+    n++;
+    input_ptr += E;
+  }
+  *cb_ok += ok_before;
+  if (n == 0) {
+    return SRSRAN_SUCCESS;
+  }
+
+  srsran_crc_t* crc      = (cfg->L_tb == 16) ? &q->crc_tb_16 : &q->crc_tb_24;
+  uint32_t      crc_type = (cfg->L_tb == 16) ? 16 : 241;
+  if (cfg->L_cb) {
+    crc      = &q->crc_cb;
+    crc_type = 242;
+  }
+  float avg_iter = 0.0f;
+  if (srsran_ldpc_cuda_decode_tb((srsran_ldpc_cuda_t*)q->cuda, (cfg->bg == BG1) ? 1 : 2, cfg->Z, cfg->F, n, llr_ptrs, n_llr, crc_type, msg_ptrs, &avg_iter) < 0) {
+    return SRSRAN_ERROR;
+  }
+  uint32_t iter_ok = (uint32_t)(avg_iter + 0.5f);
+  if (iter_ok == 0) {
+    iter_ok = 1;
+  }
+  for (uint32_t k = 0; k < n; k++) {
+    uint32_t r   = cb_idx[k];
+    uint8_t* msg = msg_ptrs[k];
+    bool     ok  = srsran_crc_match(crc, msg, (int)(decoder->liftK - crc->order));
+    tb->softbuffer.rx->cb_crc[r] = ok;
+    *nof_iter_sum += ok ? iter_ok : decoder->max_nof_iter;
+    if (ok) {
+      srsran_bit_pack_vector(msg, tb->softbuffer.rx->data[r], cb_len);
+      (*cb_ok)++;
+    }
+  }
+  return SRSRAN_SUCCESS;
+}
+#endif // SRSRAN_LDPC_CUDA
+
+/* Local S1 diagnostic: SRSRAN_SCH_TIMING=1 prints p50/p90/p99 of the per-TB decode section every 1000 TBs. */
+static int    sch_timing_enabled = -1;
+static double sch_timing_buf[1000];
+static int    sch_timing_n = 0;
+static int    sch_timing_cmp(const void* a, const void* b) { double x = *(const double*)a, y = *(const double*)b; return (x > y) - (x < y); }
+static inline double sch_timing_now_us(void) { struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts); return ts.tv_sec * 1e6 + ts.tv_nsec / 1e3; }
+static void sch_timing_add(double us, uint32_t C, uint32_t nof_prb_hint, const char* backend)
+{
+  sch_timing_buf[sch_timing_n++] = us;
+  if (sch_timing_n == 1000) {
+    qsort(sch_timing_buf, 1000, sizeof(double), sch_timing_cmp);
+    fprintf(stderr, "[sch_timing] backend=%s last_C=%u p50=%.0f p90=%.0f p99=%.0f max=%.0f us\n", backend, C, sch_timing_buf[500], sch_timing_buf[900], sch_timing_buf[990], sch_timing_buf[999]);
+    sch_timing_n = 0;
+  }
+}
+
 static int sch_nr_decode(srsran_sch_nr_t*        q,
                          const srsran_sch_cfg_t* sch_cfg,
                          const srsran_sch_tb_t*  tb,
@@ -607,6 +745,19 @@ static int sch_nr_decode(srsran_sch_nr_t*        q,
   uint32_t cb_ok = 0;
   res->crc       = false;
 
+  if (sch_timing_enabled < 0) {
+    const char* te = getenv("SRSRAN_SCH_TIMING");
+    sch_timing_enabled = (te != NULL && te[0] != '0') ? 1 : 0;
+  }
+  double sch_t0 = sch_timing_enabled ? sch_timing_now_us() : 0.0;
+
+  bool cuda_done = false;
+#ifdef SRSRAN_LDPC_CUDA
+  if (q->cuda != NULL) {
+    cuda_done = (sch_nr_decode_cuda_cbs(q, &cfg, tb, decoder, e_bits, &cb_ok, &nof_iter_sum) == SRSRAN_SUCCESS);
+  }
+#endif // SRSRAN_LDPC_CUDA
+  if (!cuda_done) {
   // For each code block...
   uint32_t j = 0;
   for (uint32_t r = 0; r < cfg.C; r++) {
@@ -691,6 +842,10 @@ static int sch_nr_decode(srsran_sch_nr_t*        q,
 
     input_ptr += E;
   }
+  } // !cuda_done
+  if (sch_timing_enabled) {
+    sch_timing_add(sch_timing_now_us() - sch_t0, cfg.C, 0, cuda_done ? "cuda" : "cpu");
+  }
   // Set average number of iterations
   res->avg_iter = (float)nof_iter_sum / (float)cfg.C;
 
