  "code": {
    "broker.cpp:1153": "1153          // (A) Output room. Every RX row must be able to take at least one\n1154          // sample. Partial progress is deliberate and mirrors the input side:\n1155          // demanding a full batch of headroom would strand the partial chunks a\n1156          // lock-step radio leaves behind, which is the B2.2 dead-lock in a new\n1157          // place.\n1158          diag.state.store(\"wait_room\");\n1159          const auto t_room_start = std::chrono::steady_clock::now();\n1160          std::size_t room = 0;\n1161          bool room_stall_reported = false;\n1162          auto next_room_report = t_room_start + kStallReportInterval;\n1163          while (!stop_requested.load()) {\n1164            room = node.batch;\n1165            for (const std::size_t r : node.rx_ports) {\n1166              room = std::min(room, rx_headroom(*ports[r]));\n1167            }\n1168            if (room > 0) {\n1169              break;\n1170            }\n1171            diag.blocked_iters.fetch_add(1);\n1172            const auto now = std::chrono::steady_clock::now();\n1173            if (now >= next_room_report) {\n1174              report_node_stall(node, \"output_room\", now - t_room_start);\n1175              room_stall_reported = true;\n1176              next_room_report = now + kStallReportInterval;\n1177            }\n1178            wait_tick(knobs, t_room_start);\n1179          }\n1180          // Only a genuine resume clears; a stop request is a shutdown, not\n1181          // recovery, and must not be logged as one.\n1182          if (room_stall_reported && !stop_requested.load()) {\n1183            report_node_stall_cleared(node, \"output_room\",\n1184                                      std::chrono::steady_clock::now() - t_room_start);\n1185          }\n1186          if (room == 0) {\n1187            break; // stop requested while waiting for output room\n1188          }\n1189          const auto t_align_start = std::chrono::steady_clock::now();\n1190          const double room_us =\n1191              std::chrono::duration<double, std::micro>(t_align_start - t_room_start).count();\n1192  \n1193          // (B) First slot: co-initialise every incoming lane's cursor to its",
    "broker.cpp:1212": "1212          const double align_us =\n1213              std::chrono::duration<double, std::micro>(t_data_start - t_align_start).count();\n1214  \n1215          // (C) Common input window: the largest amount simultaneously available\n1216          // on EVERY incoming lane, capped at the node batch and at the output\n1217          // room, instead of blocking until each lane holds a full fixed batch.\n1218          // A fixed-batch serve strands the partial final chunk every lock-step\n1219          // radio leaves on its ring; in a multi-device fan-in/fan-out topology\n1220          // no radio can advance to refill it, so the whole relay dead-locks.\n1221          std::size_t count = 0;\n1222          if (incoming.empty()) {\n1223            count = room; // no lanes -> zero-fill, still paced and bounded\n1224          } else {\n1225            const auto wait_start = std::chrono::steady_clock::now();\n1226            bool starvation_counted = false;\n1227            bool data_stall_reported = false;\n1228            auto next_data_report = wait_start + kStallReportInterval;\n1229            while (!stop_requested.load()) {\n1230              std::size_t common = node.batch;\n1231              for (std::size_t k = 0; k != incoming.size(); ++k) {\n1232                auto& link = links[incoming[k]];\n1233                PortRuntime& src = *ports[link.src_index];\n1234                std::lock_guard<std::mutex> lk(src.ring_mutex);\n1235                std::uint64_t cur = link.cursor.load();\n1236                if (cur < src.tx_ring.earliest_sequence()) {\n1237                  cur = src.tx_ring.earliest_sequence();\n1238                  link.cursor.store(cur);\n1239                  stats.tx_sequence_gaps.fetch_add(1);\n1240                  diag.sequence_gaps.fetch_add(1, std::memory_order_relaxed);\n1241                }\n1242                const std::uint64_t avail = src.tx_ring.next_sequence() - cur;\n1243                common = std::min<std::size_t>(common, static_cast<std::size_t>(avail));\n1244              }\n1245              if (common > 0) {\n1246                count = std::min(common, room);\n1247                break;\n1248              }\n1249              diag.state.store(\"wait_data\");\n1250              diag.blocked_iters.fetch_add(1);\n1251              const auto now = std::chrono::steady_clock::now();\n1252              // Only a node that has already produced can be starved; the first\n1253              // wait is the relay filling, not a real-time miss. The slot counter\n1254              // states that directly -- the throttle bookkeeping this used to\n1255              // read was rebased to zero once a second, so a starvation landing\n1256              // in that one slot went uncounted.\n1257              if (diag.progress.load() > 0 && !starvation_counted &&\n1258                  now - wait_start > starvation_deadline) {\n1259                stats.rx_starvations.fetch_add(1);\n1260                diag.starvations.fetch_add(1, std::memory_order_relaxed);\n1261                starvation_counted = true;\n1262              }\n1263              if (now >= next_data_report) {\n1264                report_node_stall(node, \"input_data\", now - wait_start);\n1265                data_stall_reported = true;\n1266                next_data_report = now + kStallReportInterval;\n1267              }\n1268              wait_tick(knobs, wait_start);\n1269            }\n1270            if (data_stall_reported && !stop_requested.load()) {\n1271              report_node_stall_cleared(node, \"input_data\",\n1272                                        std::chrono::steady_clock::now() - wait_start);\n1273            }\n1274          }\n1275          if (count == 0) {\n1276            break; // stop requested while waiting for lane data\n1277          }\n1278          // Opt-in sample-indexed control: a call never straddles a pending\n1279          // take_effect_at_sample or noise epoch of an incoming link, so the\n1280          // update starts exactly at its target sample instead of at whichever\n1281          // call boundary follows it. Inert (no target set) for every caller\n1282          // that does not name one.\n1283          for (BrokerLinkControl* ctl : node_controls[n]) {",
